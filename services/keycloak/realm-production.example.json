{
  "realm": "dataspaces",
  "enabled": true,
  "organizationsEnabled": true,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "ds-admin",
        "description": "Dataspace platform administrator"
      },
      {
        "name": "dataset.admin",
        "description": "Dataset provider operator"
      }
    ]
  },
  "groups": [
    {
      "name": "ds-admin"
    },
    {
      "name": "ds-onboarding-operator"
    },
    {
      "name": "ds-participant-admin"
    },
    {
      "name": "ds-participant-viewer"
    },
    {
      "name": "ds-member"
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect"
    },
    {
      "name": "email",
      "protocol": "openid-connect"
    },
    {
      "name": "roles",
      "protocol": "openid-connect"
    },
    {
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "organization",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "organization",
            "userinfo.token.claim": "true"
          },
          "consentRequired": false
        }
      ]
    },
    {
      "name": "dataset.query",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dataset.query",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "scope",
            "claim.value": "dataset.query",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "dataset.read",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dataset.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "scope",
            "claim.value": "dataset.read",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "oauth2_proxy",
      "name": "oauth2-proxy (human login)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://sso.dataspaces.example.org/oauth2/callback"
      ],
      "webOrigins": [
        "https://portal.dataspaces.example.org",
        "https://sso.dataspaces.example.org"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "groups",
        "organization"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "post.logout.redirect.uris": "https://sso.dataspaces.example.org/oauth2/sign_out"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
