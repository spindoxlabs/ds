# ── DID resolution — every *.dataspaces.localhost host ──────────────────────
#
# did:web:rec.dataspaces.localhost → GET http://rec.dataspaces.localhost/.well-known/did.json
# Caddy rewrites to the identity-registry at /dids/did:web:{host}/did.json
#
# A portless DID resolves on **port 80** — there is no other port a did:web
# resolver will try. Caddy therefore publishes :80 on the host, which is what
# makes this block reachable both ways: container-to-container through the
# Docker network aliases on the caddy service, and from a host-run EDC through
# 127.0.0.1:80 (the .localhost TLD resolves to loopback).
#
# Hosts that have their own site block below (consumer, portal, sso, keycloak)
# do NOT fall through to this wildcard — a specific host wins over `*`. The
# consumer is also a participant DID, so its block repeats this handler.
http://*.dataspaces.localhost {
	handle /.well-known/did.json {
		rewrite * /dids/did:web:{http.request.host}/did.json
		# The host gateway, not the Docker service name. `identity-registry:30005`
		# resolves only inside the compose network, so with the registry running on
		# the host (`task dev:*`) DID resolution 502'd and the EDC fell back to
		# DemoIdentityFallbackExtension — one of the two reasons that fallback
		# existed. 172.17.0.1 resolves identically from a container and from the
		# host, which is the rule the root guide states for every backend call.
		reverse_proxy 172.17.0.1:30005
	}

	# The participant-facing halves of DCP, on the host the DID names.
	#
	# A DID document publishes its own CredentialService endpoint, and every
	# counterparty and every EDC calls exactly that URL. It used to be
	# `http://identity-registry:30005/…` — a Docker service name, so the endpoint
	# a *published, signed* document advertised was unreachable from the host, from
	# a `dev:*` EDC, and from anything outside this compose network. Same host as
	# the DID, same port 80, resolvable both ways.
	#
	# **On the wildcard these still reach the anchor**, and that is correct for
	# the one host that falls through to here: the trust anchor's own DID. A host
	# that belongs to a *participant* has its own block below, pointing at that
	# participant's own instance — which is the whole of `DID-05` expressed in
	# routing, and since `DID-11` step 2 that includes the people it holds
	# credentials for.
	handle /credentials/* {
		reverse_proxy 172.17.0.1:30005
	}

	handle /sts/* {
		reverse_proxy 172.17.0.1:30005
	}

	respond 404
}

# ── The REC: a provider that has members (`DID-05`, `D-54`) ──────────────────
#
# `rec.dataspaces.localhost` is a participant DID host, and after the split every
# DCP surface on it belongs to that participant's **own** registry, not to the
# anchor:
#
#   /.well-known/did.json   the document publishing the key the provider holds
#   /credentials/*          its credential store and presentation endpoint
#   /sts/*                  its own Secure Token Service
#
# Getting this wrong is quiet in exactly the wrong way. Point it back at the
# anchor and DID resolution still answers — with the anchor's *record* of the
# provider — while presentation queries return an empty VP, because the anchor
# holds no credentials for a participant it delivered them to.
http://rec.dataspaces.localhost {
	handle /.well-known/did.json {
		rewrite * /dids/did:web:{http.request.host}/did.json
		reverse_proxy 172.17.0.1:30006
	}

	# **A member's DID document, on the host their DID names** (`DID-11` step 2).
	#
	# `did:web:rec.dataspaces.localhost:users:alice` resolves at
	# `/users/alice/did.json` — path segments, per the did:web method. Subject
	# DIDs used to live under a flat `users.dataspaces.localhost` and be served
	# by the anchor, which said that every person in the dataspace belonged to
	# the trust anchor. They belong to the organisation that onboarded them, and
	# that organisation's instance is what publishes them — it learns of a person
	# by *receiving their credential*, which is what makes this row exist there.
	#
	# This also closes `personal-data.md` `D-22` without a rule of its own: a
	# path-bearing subject DID now resolves through the participant's `/dids`
	# route like any other.
	@userdid path_regexp userdid ^/users/([^/]+)/did\.json$
	handle @userdid {
		rewrite * /dids/did:web:{http.request.host}:users:{re.userdid.1}/did.json
		reverse_proxy 172.17.0.1:30006
	}

	handle /credentials/* {
		reverse_proxy 172.17.0.1:30006
	}

	handle /sts/* {
		reverse_proxy 172.17.0.1:30006
	}

	# The instance's own health, which reports its **role**. Routed here so the
	# topology is observable from outside the cluster: `dcp-trust` names the
	# identity topology it exercised (`T-1`'s banner rule), and it can only do
	# that by asking each host what it is. Without this the probe 404s and a run
	# against a fully split stack reports "NOT split" — a banner that lies is
	# worse than no banner.
	handle /health {
		reverse_proxy 172.17.0.1:30006
	}

	respond 404
}

# ── Grid operator: the second provider (`D-54`, `DID-15`) ────────────────────
#
# `grid-operator.dataspaces.localhost` is a participant DID host like the two
# above, and gets the same surfaces from its own instance (:30008). It exists to
# make "which provider?" a real question: this one shares its own grid data and
# has **no members**, so nothing downstream can assume every participant has a
# member store.
http://grid-operator.dataspaces.localhost {
	handle /.well-known/did.json {
		rewrite * /dids/did:web:{http.request.host}/did.json
		reverse_proxy 172.17.0.1:30008
	}

	# A member's DID document, on the host their DID names (`DID-11` step 2).
	# **This participant has none** — and the route is here anyway, because the
	# shape of a participant host must not depend on whether it happens to hold
	# credentials for anybody. It answers 404 per person, which is the honest
	# answer and a different thing from the route not existing.
	@userdid path_regexp userdid ^/users/([^/]+)/did\.json$
	handle @userdid {
		rewrite * /dids/did:web:{http.request.host}:users:{re.userdid.1}/did.json
		reverse_proxy 172.17.0.1:30008
	}

	handle /credentials/* {
		reverse_proxy 172.17.0.1:30008
	}

	handle /sts/* {
		reverse_proxy 172.17.0.1:30008
	}

	# Its role, for the topology banner — see the provider block.
	handle /health {
		reverse_proxy 172.17.0.1:30008
	}

	respond 404
}

# ── Human authentication (oauth2-proxy) ──────────────────────────────────────
#
# Adapted from a configuration already proven in the sibling platform. The two
# parts that took the longest to get right are kept verbatim in spirit:
#
#  1. **sign_out is intercepted before oauth2-proxy sees it.** The browser goes to
#     Keycloak's end_session endpoint first, which clears the *Keycloak* SSO
#     session, and Keycloak then redirects to the proxy's sign_out to clear the
#     proxy cookie. Skip this and only the local cookie is cleared — Keycloak
#     silently re-authenticates on the next visit, so "sign out" appears to do
#     nothing.
#  2. **`/oauth2/*` is excluded from the auth pre-flight.** sign_in and callback
#     must reach oauth2-proxy directly; running forward_auth on them means the
#     callback code is checked for a session that does not exist yet.
#
# Every URL here is portless because the gateway owns :80. Keep it that way: a
# port that appears in one URL and not another is the classic cause of a
# redirect loop, and oauth2-proxy's `whitelist_domains` matches the default port
# only unless a port is listed explicitly.
(auth) {
	handle /oauth2/sign_out {
		redir * http://keycloak.dataspaces.localhost/realms/dataspaces/protocol/openid-connect/logout?client_id=oauth2_proxy&post_logout_redirect_uri=http%3A%2F%2Fsso.dataspaces.localhost%2Foauth2%2Fsign_out 302
	}

	@needs_auth not path /oauth2/*
	forward_auth @needs_auth oauth2-proxy:4180 {
		uri /oauth2/auth

		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}

		copy_headers \
			X-Auth-Request-User \
			X-Auth-Request-Email \
			X-Auth-Request-Groups \
			X-Auth-Request-Access-Token \
			Authorization

		@unauthenticated status 401
		handle_response @unauthenticated {
			redir * http://sso.dataspaces.localhost/oauth2/sign_in?rd={scheme}://{hostport}{uri}
		}
	}
}

# ── Keycloak ─────────────────────────────────────────────────────────────────

http://keycloak.dataspaces.localhost {
	reverse_proxy 172.17.0.1:9080
}

# ── SSO host — oauth2-proxy's own endpoints ──────────────────────────────────
#
# Docker service name, not 172.17.0.1: the proxy publishes no host port, so this
# is the only route to it and there is nothing to collide with.
http://sso.dataspaces.localhost {
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}
	# The bare redirect must live inside its own `handle` to stay exclusive with
	# the block above — otherwise Caddy runs it for /oauth2/* too and forwards
	# callback codes to the portal.
	handle {
		redir * http://portal.dataspaces.localhost{uri} 302
	}
}

# ── Trust anchor ─────────────────────────────────────────────────────────────
#
# A specific host block, so it does NOT fall through to the wildcard above —
# which means the DID handler is repeated here, exactly as it is for the consumer.
#
# `/status/*` is what makes revocation checkable. A StatusList2021 URL is written
# *inside* the signed credential and fetched by every verifier, so it has to be
# reachable on the same host the DID names and over the same scheme the dataspace
# resolves with. It was `https://trust-anchor.dataspaces.localhost/status/1`,
# which dev serves on no port: the EDC's revocation check failed to connect,
# failed closed, and every negotiation died at the identity step — visible only
# once the demo identity fallback stopped hiding it.
#
# Public and unauthenticated by rulebook `P-13`.
http://trust-anchor.dataspaces.localhost {
	handle /.well-known/did.json {
		rewrite * /dids/did:web:{http.request.host}/did.json
		reverse_proxy 172.17.0.1:30005
	}

	handle /status/* {
		reverse_proxy 172.17.0.1:30005
	}

	# **The Issuer Service** — CIP's Credential Request API and the metadata that
	# describes it. The anchor's DID document publishes this URL as an
	# `IssuerService` service entry, which is how an organisation finds where to
	# enrol from the anchor's identifier alone (`DID-14`).
	#
	# It has to be routed *here*, on the host the DID names. Reachable only on
	# :30005, the published entry points at something nothing outside the cluster
	# can fetch — a discovery mechanism that resolves to a 404 is worse than none,
	# because it looks like it works.
	#
	# `/issuer/metadata` is public by design (it is what a stranger reads first);
	# `/issuer/credentials` authenticates the caller by a Self-Issued ID token it
	# verifies against the caller's own DID document, so there is nothing here for
	# Caddy to guard.
	handle /issuer/* {
		reverse_proxy 172.17.0.1:30005
	}

	# The dataspace's list of accredited entities (`P-12a`, `DSSC-TRF-05`).
	#
	# Public and on the anchor's own host, for the same reason `/status/*` is: a
	# counterparty decides whether to accept a credential **before** it has any
	# relationship with this dataspace, and a federation partner reads this
	# before anything else. Reachable only on :30005 it would be readable by
	# nobody outside the cluster, which is the same as not publishing it.
	handle /trust {
		reverse_proxy 172.17.0.1:30005
	}

	respond 404
}

# ── The third party: a gateway, and the only consumer ────────────────────────
#
# `third-party.dataspaces.localhost` is both a gateway host and a participant DID
# (`did:web:third-party.dataspaces.localhost`). This block is more specific than
# the `*.dataspaces.localhost` wildcard above, so the wildcard's DID handler
# never runs for it — the handler is repeated here or this participant's DID
# document 404s and every negotiation against it fails at the identity check.

http://third-party.dataspaces.localhost {
	# **This participant's own registry (:30007), not the anchor.** Same reasoning
	# as the REC's block above; see `DID-05`.
	handle /.well-known/did.json {
		rewrite * /dids/did:web:{http.request.host}/did.json
		reverse_proxy 172.17.0.1:30007
	}

	# **A member's DID document, on the host their DID names** (`DID-11` step 2).
	#
	# `did:web:rec.dataspaces.localhost:users:alice` resolves at
	# `/users/alice/did.json` — path segments, per the did:web method. Subject
	# DIDs used to live under a flat `users.dataspaces.localhost` and be served
	# by the anchor, which said that every person in the dataspace belonged to
	# the trust anchor. They belong to the organisation that onboarded them, and
	# that organisation's instance is what publishes them — it learns of a person
	# by *receiving their credential*, which is what makes this row exist there.
	#
	# This also closes `personal-data.md` `D-22` without a rule of its own: a
	# path-bearing subject DID now resolves through the participant's `/dids`
	# route like any other.
	@userdid path_regexp userdid ^/users/([^/]+)/did\.json$
	handle @userdid {
		rewrite * /dids/did:web:{http.request.host}:users:{re.userdid.1}/did.json
		reverse_proxy 172.17.0.1:30007
	}

	# Repeated from the wildcard, for the same reason as the DID handler above:
	# this host has its own block, so it never falls through.
	handle /credentials/* {
		reverse_proxy 172.17.0.1:30007
	}

	handle /sts/* {
		reverse_proxy 172.17.0.1:30007
	}

	# The instance's own health, which reports its **role**. Routed here so the
	# topology is observable from outside the cluster: `dcp-trust` names the
	# identity topology it exercised (`T-1`'s banner rule), and it can only do
	# that by asking each host what it is. Without this the probe 404s and a run
	# against a fully split stack reports "NOT split" — a banner that lies is
	# worse than no banner.
	handle /health {
		reverse_proxy 172.17.0.1:30007
	}

	handle_path /api/connector/* {
		reverse_proxy 172.17.0.1:31001
	}

	handle_path /api/provenance/* {
		reverse_proxy 172.17.0.1:31000
	}

	# Anything else is not a consumer-gateway route. Without this the site matches
	# but no handler does, and Caddy answers 200 with an empty body — which reads
	# as "endpoint exists, returned nothing" to a caller that mistyped a prefix.
	respond 404
}

# ── Provider gateway ─────────────────────────────────────────────────────────

http://portal.dataspaces.localhost {
	# A client must never be able to assert its own identity. oauth2-proxy sets
	# these on the way through; anything arriving from outside is stripped first,
	# so a forged `X-Auth-Request-Access-Token` cannot reach the portal. The portal
	# treats the header as transport only and every ds service re-verifies the JWT
	# — this is defence in depth, not the only control.
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Auth-Request-Access-Token
	request_header -X-Auth-Request-Preferred-Username

	route {
		# Before the catch-all /oauth2/* below, and before the (auth) snippet's own
		# copy: inside `route` the first matching `handle` wins, so a generic
		# /oauth2/* would shadow the more specific sign_out and clear only the proxy
		# cookie — leaving Keycloak's SSO session alive to re-authenticate silently.
		handle /oauth2/sign_out {
			redir * http://keycloak.dataspaces.localhost/realms/dataspaces/protocol/openid-connect/logout?client_id=oauth2_proxy&post_logout_redirect_uri=http%3A%2F%2Fsso.dataspaces.localhost%2Foauth2%2Fsign_out 302
		}

		handle /oauth2/* {
			reverse_proxy oauth2-proxy:4180
		}

		# Public by design, and it has to stay that way: an organisation applying to
		# join **has no identity yet**, so the invite link is the only credential it
		# holds and the page must render for an anonymous browser
		# (`routes/join/+page.server.ts` says so in as many words). Behind the auth
		# wall the applicant is bounced to a login form for an account that does not
		# exist — which is what the operator journey caught.
		handle /join* {
			reverse_proxy 172.17.0.1:30004
		}

		# Machine-scraped, and a 302 to a login form would break a scraper silently
		# rather than loudly. This preserves the pre-existing exposure that root
		# AGENTS.md already records as a known gap — it does not widen it.
		handle /metrics* {
			reverse_proxy 172.17.0.1:30004
		}

		# The API paths stay **outside** the auth snippet on purpose. Each service
		# authenticates its own callers, and an unauthenticated API call should be a
		# 401 the caller can act on — not a 302 to a login form it cannot complete.
		handle_path /api/connector/* {
			reverse_proxy 172.17.0.1:30001
		}

		handle_path /api/provenance/* {
			reverse_proxy 172.17.0.1:30000
		}

		handle_path /api/catalog/* {
			reverse_proxy 172.17.0.1:30003
		}

		handle_path /api/datasets/* {
			reverse_proxy 172.17.0.1:30002
		}

		# The browser surface: authenticated, or redirected to Keycloak.
		handle {
			import auth
			reverse_proxy 172.17.0.1:30004
		}
	}
}
