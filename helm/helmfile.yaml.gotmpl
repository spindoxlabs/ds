# ==============================================================================
# Dataspace deployment — release composition
# ==============================================================================
#
# **A base, not a deployment.** A deployment drives this file from its own
# repository, with its own helmfile, values and sops-encrypted secrets
# (`every-secret-has-one-source`, M1): ds is public, so a real deployment's
# ciphertext never sits in this tree. See helm/README.md, "Deploying from your
# own repository":
#
#   helmfiles:
#     - path: <ds checkout>/helm/helmfile.yaml.gotmpl
#       values:
#         - <the parent's .Values, rendered with toYaml>  # values + decrypted secrets
#
# The parent's environment must be one this file declares (`staging` or
# `production`): helmfile skips a sub-helmfile in any other, silently.
#
# Release groups, in dependency order:
#   ds-namespaces        — labeled namespaces (participant label drives NetPols)
#   authority            — ds-identity-registry, once per dataspace
#   participant          — ds-edc / ds-connector / ds-provenance per participant
#
# Release NAMES follow ds-<service>-<participant> so a chart can address a
# sibling's Service from the participant name alone (see ds-connector/_env.tpl).
#
# Configuration: values.yaml here is the base; the deployment's values and its
# secrets are merged over it. The secret policy below runs on the merged result.
# ==============================================================================

environments:
  # ── The environments a deployment drives ────────────────────────────────────
  #
  # A helmfile renders a sub-helmfile only in an environment the sub-helmfile
  # declares, so these names are the ones a deployment's own helmfile may use.
  # Each reads only the committed base values. `secrets.sops.yaml` beside this
  # file is optional (`missingFileHandler: Warn`): an operator who still keeps
  # one here gets it read, and a deployment passing its secrets down needs none.
  # Nothing is optional *in effect* — the secret policy below fails the render,
  # naming the key, when a secret the enabled participants need is missing.
  production:
    missingFileHandler: Warn
    values:
      - values.yaml
    secrets:
      - secrets.sops.yaml
  staging:
    missingFileHandler: Warn
    values:
      - values.yaml
    secrets:
      - secrets.sops.yaml

  # ── A local cluster ─────────────────────────────────────────────────────────
  #
  #   helm/minikube/standalone.sh all      (docs/deployment/local-cluster.md)
  #
  # The charts under the production posture on minikube, generic names only: the
  # secret policy runs (this is not `example`), the secrets are generated into
  # minikube/secrets.yaml (never committed) and must exist.
  minikube:
    values:
      - values.yaml
      - minikube/values.yaml.gotmpl
      - minikube/secrets.yaml

  # ── The environment that makes this file checkable ──────────────────────────
  #
  #   helmfile -e example template
  #
  # Identical to the others except that the secrets come from the **committed
  # example** as plain values. It deploys nothing — every value in it is
  # `CHANGE_ME` — and exists so the release composition can be rendered by
  # anyone, with no key. It is the one environment the placeholder and custody
  # checks of the secret policy do not run in.
  #
  # **This is not a convenience.** Before it existed `helmfile template` could
  # not run in a clean checkout at all — and the chart set went unrendered long
  # enough to accumulate a page of defects that a single render names. The one
  # that proves the point: `ds-provenance` `required`d a `trustAnchorPublicJwk`
  # the helmfile passed only to `ds-connector`, so **every production deploy
  # would have failed at that release**, and nothing said so until someone
  # rendered it by hand.
  #
  # A `required` that is never exercised is not a guard, it is a comment. Keep
  # this environment rendering.
  example:
    values:
      - values.yaml
      - values.example.yaml
      - secrets.example.yaml

---

# ── Which release of the platform this deploys ────────────────────────────────
#
# Every image tag comes from one place. `task release` stamps the release
# version into each chart's appVersion, and `ds.image` falls back to it when
# `global.image.tag` is empty — so a checkout of tag vX.Y.Z deploys :X.Y.Z with
# no further configuration.
#
# DS_IMAGE_TAG overrides that for the whole deployment without editing
# values.yaml, which is what CI and a rollback want:
#
#   DS_IMAGE_TAG=1.4.0 helmfile -e production apply
#
# `merge` keeps the left-hand value, so the override wins over values.yaml and
# everything else in `global` is carried through untouched.
{{- $global := .Values.global }}
{{- with env "DS_IMAGE_TAG" }}
{{- $global = merge (dict "image" (dict "tag" .)) $global }}
{{- end }}

{{- /*
================================================================================
The participant profiles (docs/deployment/configuration.md, "Participants")

Each `participants[]` entry is a profile: a name, an explicit `enabled`, a role, and
feature switches (`portal`, `federatedCatalog`, `collector`, `enrolment`), each a
block with a boolean `enabled`. Everything else (namespace, hosts, DID, databases,
client ids) is derived from the name. `participantDefaults` is merged under every
entry, the entry winning; it may carry only the chart blocks, because a merge does
not let an entry's `false` override a default's `true`, so a default switch could
never be turned off again.

`$participants` is the result: the **enabled** entries only, merged and validated.
Every release, URL, check and list below ranges over it, never over
`.Values.participants`, so a disabled entry renders nothing at all and is not even
validated beyond its name and flag.
================================================================================
*/}}
{{- $pdefaults := .Values | get "participantDefaults" dict | default dict }}
{{- range $key, $_ := $pdefaults }}
{{- if not (has $key (list "connector" "provenance" "edc")) }}
{{- fail (printf "participantDefaults.%s cannot be set: only the chart blocks connector, provenance and edc can have a default (a default switch or identity could not be overridden by an entry's false or empty value)" $key) }}
{{- end }}
{{- end }}
{{- $participants := list }}
{{- $seen := dict }}
{{- range $i, $raw := .Values.participants | default list }}
{{- $name := $raw | get "name" "" | toString }}
{{- if not $name }}
{{- fail (printf "participants[%d].name is required" $i) }}
{{- end }}
{{- if hasKey $seen $name }}
{{- fail (printf "participants[%s] is declared twice" $name) }}
{{- end }}
{{- $_ := set $seen $name true }}
{{- if not (hasKey $raw "enabled") }}
{{- fail (printf "participants[%s].enabled is required: true or false. A participant is never on or off by omission" $name) }}
{{- end }}
{{- if not (kindIs "bool" $raw.enabled) }}
{{- fail (printf "participants[%s].enabled must be a boolean (true or false), not %q" $name (toString $raw.enabled)) }}
{{- end }}
{{- if $raw.enabled }}
{{- $p := mergeOverwrite (deepCopy $pdefaults) (deepCopy $raw) }}
{{- if not (has ($p | get "role" "" | toString) (list "provider" "consumer" "both")) }}
{{- fail (printf "participants[%s].role must be provider, consumer or both, not %q" $name ($p | get "role" "" | toString)) }}
{{- end }}
{{- range $feature := list "portal" "federatedCatalog" "collector" "enrolment" }}
{{- $block := $p | get $feature dict | default dict }}
{{- if and (hasKey $block "enabled") (not (kindIs "bool" $block.enabled)) }}
{{- fail (printf "participants[%s].%s.enabled must be a boolean (true or false), not %q" $name $feature (toString $block.enabled)) }}
{{- end }}
{{- end }}
{{- $participants = append $participants $p }}
{{- end }}
{{- end }}
{{- $byName := dict }}
{{- range $participants }}{{ $_ := set $byName .name . }}{{ end }}

{{- /* The databases: <namePrefix><base>[_<participant>], each with a login role of the same name. */}}
{{- $dbs := .Values.global.postgres | get "databases" dict | default dict }}
{{- $dbPrefix := $dbs | get "namePrefix" "" }}
{{- $anchorDb := printf "%s%s" $dbPrefix ($dbs | get "identityRegistry" "identity_registry") }}
{{- $dbBase := dict "identityRegistry" ($dbs | get "identityRegistryPrefix" "identity_registry") "connector" ($dbs | get "connectorPrefix" "connector") "provenance" ($dbs | get "provenancePrefix" "provenance") "edc" ($dbs | get "edcPrefix" "edc") }}

{{- /* ds2: one portal host per participant; two portals on one host fail. */}}
{{- $portalHosts := dict }}
{{- $portalHostOf := dict }}
{{- range $participants }}
{{- $pp := . }}
{{- if dig "portal" "enabled" false . }}
{{- $host := dig "portal" "host" "" . | default (printf "%s.%s" ($global.hosts.portal | default "portal") $global.baseDomain) }}
{{- if hasKey $portalHosts $host }}
{{- fail (printf "participants %s and %s both put their portal on %s: one host, one portal (its Ingress and its oauth2-proxy's /oauth2 path). Set participants[].portal.host for one of them" (index $portalHosts $host) $pp.name $host) }}
{{- end }}
{{- $_ := set $portalHosts $host .name }}
{{- $_ := set $portalHostOf .name $host }}
{{- end }}
{{- end }}

{{- /* ds1: the collector switch, each holder an enabled participant (ADR-0026). */}}
{{- $collectorPairs := list }}
{{- range $participants }}
{{- $c := . }}
{{- if dig "collector" "enabled" false $c }}
{{- $holders := dig "collector" "holders" list $c }}
{{- if not $holders }}
{{- fail (printf "participants[%s].collector.holders is empty: a collector collects consent for at least one holder, an enabled participant whose connector holds it (ADR-0026)" $c.name) }}
{{- end }}
{{- range $holders }}
{{- if not (hasKey $byName (toString .)) }}
{{- fail (printf "participants[%s].collector.holders names %q, which is not an enabled participant: the pair could never form" $c.name (toString .)) }}
{{- end }}
{{- $h := index $byName (toString .) }}
{{- $collectorPairs = append $collectorPairs (dict "holderDid" ($h.did | default (printf "did:web:%s.%s" $h.name $global.baseDomain)) "collectorDid" ($c.did | default (printf "did:web:%s.%s" $c.name $global.baseDomain))) }}
{{- end }}
{{- end }}
{{- end }}

{{- /* ds4: enrolment of co-hosted participants, off by default. */}}
{{- $enrolments := list }}
{{- range $participants }}
{{- if dig "enrolment" "enabled" false . }}
{{- $roles := dig "enrolment" "roles" list . }}
{{- if not $roles }}
{{- $roles = index (dict "provider" (list "provider") "consumer" (list "consumer") "both" (list "provider" "consumer")) .role }}
{{- end }}
{{- $scopes := dig "enrolment" "scopes" list . }}
{{- if not $scopes }}
{{- $scopes = list "dataspaces.query" }}
{{- if has .role (list "consumer" "both") }}{{ $scopes = append $scopes (printf "owner:%s:member" .name) }}{{ end }}
{{- end }}
{{- $enrolments = append $enrolments (dict "alias" .name "roles" $roles "scopes" $scopes) }}
{{- end }}
{{- end }}


{{- /*
================================================================================
The secret policy (`every-secret-has-one-source`, M2)

Runs on the merged values — ds's base, the deployment's overrides and its
decrypted secrets — before any release renders, because only here is every value
in view at once; no single pod sees two releases' keys. Each refusal names the
key path and never the value.

  presence    every enabled participant has its secrets entry (else a nil
              pointer deep inside a release names nothing useful)
  R2          no placeholder or dev literal in any secret      — not in `example`
  R3          no custody key shared: the anchor's and every participant's
              encryption key, every two participants' encryption and control
              keys                                              — not in `example`
  svc-edc     every EDC logs in as the one realm client `svc-edc`, so every
              participant's `connectorClientSecret` (and `svcEdcSecret`) is the
              SAME value — the opposite of a custody key
  org client  posture A: org-sync's `organisationClients.<alias>.connectorSecret`
              equals the connector's `organisationClientSecret`
  R4          no EDR signing key from the committed dev fixtures
  EDR halves  `edcVault.edrSigningPublicJwk` is `edrSigningPrivateJwk` without
              its private member — chart parity OQ1 (b): two halves an operator
              supplies, checked to agree; and the connector's half holds no `d`
  anchor      a literal `trustAnchorDomain` equals the host every participant
              derives (`<hosts.trustAnchor>.<baseDomain>`), or the anchor names
              itself under a DID nobody trusts (OQ5)

Not decided here, so not enforced: whether the connector's at-rest keys and the
provenance pseudonym key must differ per participant (a maintainer question,
recorded in the deployment's D2 work log). They are covered by R2.
================================================================================
*/}}
{{- $armed := ne .Environment.Name "example" }}
{{- $sec := .Values | get "secrets" dict }}
{{- $psecAll := $sec | get "participants" dict }}
{{- $enabled := $participants }}

{{- /* presence */}}
{{- range $enabled }}
{{- if not (hasKey $psecAll .name) }}
{{- fail (printf "secret policy: secrets.participants.%s is missing — participant %q is enabled, and its secrets come from the deployment's secrets file (passed down with the values)" .name .name) }}
{{- end }}
{{- end }}

{{- /* presence — every database password, under the database's own name */}}
{{- $pg := $sec | get "postgres" dict | default dict }}
{{- if not (hasKey $pg $anchorDb) }}
{{- fail (printf "secret policy: secrets.postgres.%s is missing — the anchor's database password (the key is the database name, global.postgres.databases)" $anchorDb) }}
{{- end }}
{{- range $enabled }}
{{- $pp := . }}
{{- range $svc := list "identityRegistry" "connector" "provenance" "edc" }}
{{- $db := printf "%s%s_%s" $dbPrefix (index $dbBase $svc) (replace "-" "_" $pp.name) }}
{{- if not (hasKey $pg $db) }}
{{- fail (printf "secret policy: secrets.postgres.%s is missing — participant %q is enabled, and every database password is keyed by the database name (global.postgres.databases)" $db $pp.name) }}
{{- end }}
{{- end }}
{{- end }}

{{- /* enrolment — a code per co-hosted participant: present, long enough, never shared */}}
{{- $codes := dict }}
{{- range $enabled }}
{{- $pp := . }}
{{- if dig "enrolment" "enabled" false . }}
{{- $code := index $psecAll .name | get "enrolmentCode" "" | toString | trim }}
{{- if not $code }}
{{- fail (printf "secret policy: secrets.participants.%s.enrolmentCode is missing — participants[%s].enrolment.enabled is true, and the anchor registers that code for the participant to spend (helm/tools/generate_secrets.py generates one)" .name .name) }}
{{- end }}
{{- if lt (len $code) 32 }}
{{- fail (printf "secret policy: secrets.participants.%s.enrolmentCode is shorter than 32 characters — generate it (helm/tools/generate_secrets.py)" .name) }}
{{- end }}
{{- if hasKey $codes $code }}
{{- fail (printf "secret policy: secrets.participants.%s.enrolmentCode equals secrets.participants.%s.enrolmentCode — one code, one organisation" $pp.name (index $codes $code)) }}
{{- end }}
{{- $_ := set $codes $code .name }}
{{- end }}
{{- end }}

{{- /* R2 — placeholders and dev literals, any spelling, at any depth (≤ 5) */}}
{{- $weak := list "changeme" "admin" "password" "postgres" "secret" "test" }}
{{- $devLiterals := list "insecure-dev-secret" "insecure-dev-callback-key" "insecure-dev-control-key" "insecure-dev-key" "dev-encryption-key-change-in-production" }}
{{- if $armed }}
{{- $leaves := dict }}
{{- range $k1, $v1 := $sec }}
{{- if kindIs "map" $v1 }}{{ range $k2, $v2 := $v1 }}
{{- if kindIs "map" $v2 }}{{ range $k3, $v3 := $v2 }}
{{- if kindIs "map" $v3 }}{{ range $k4, $v4 := $v3 }}
{{- if kindIs "map" $v4 }}{{ range $k5, $v5 := $v4 }}{{ $_ := set $leaves (printf "secrets.%s.%s.%s.%s.%s" $k1 $k2 $k3 $k4 $k5) $v5 }}{{ end }}
{{- else }}{{ $_ := set $leaves (printf "secrets.%s.%s.%s.%s" $k1 $k2 $k3 $k4) $v4 }}{{ end }}
{{- end }}
{{- else }}{{ $_ := set $leaves (printf "secrets.%s.%s.%s" $k1 $k2 $k3) $v3 }}{{ end }}
{{- end }}
{{- else }}{{ $_ := set $leaves (printf "secrets.%s.%s" $k1 $k2) $v2 }}{{ end }}
{{- end }}
{{- else }}{{ $_ := set $leaves (printf "secrets.%s" $k1) $v1 }}{{ end }}
{{- end }}
{{- range $path, $value := $leaves }}
{{- $text := toString $value | trim }}
{{- $form := $text | lower | replace "_" "" | replace "-" "" }}
{{- if and $text (or (has $form $weak) (contains "changeme" $form) (has $text $devLiterals) (hasPrefix "dev-" ($text | lower))) }}
{{- fail (printf "secret policy: %s is a placeholder or a dev default — generate a real value (helm/secrets.example.yaml says how). Only the `example` environment renders placeholders." $path) }}
{{- end }}
{{- end }}
{{- end }}

{{- /* R3 — no custody key shared */}}
{{- if $armed }}
{{- $anchorKey := $sec | get "identityRegistryEncryptionKey" "" }}
{{- range $i, $a := $enabled }}
{{- $pa := index $psecAll $a.name }}
{{- if and $anchorKey (eq ($pa | get "identityRegistryEncryptionKey" "") $anchorKey) }}
{{- fail (printf "secret policy: secrets.participants.%s.identityRegistryEncryptionKey equals the anchor's secrets.identityRegistryEncryptionKey — one key per release (D-47), or every DID private key is back in one place" $a.name) }}
{{- end }}
{{- range $j, $b := $enabled }}
{{- if lt $i $j }}
{{- $pb := index $psecAll $b.name }}
{{- range $key := list "identityRegistryEncryptionKey" "edcControlApiKey" }}
{{- $va := $pa | get $key "" }}
{{- if and $va (eq $va ($pb | get $key "")) }}
{{- fail (printf "secret policy: secrets.participants.%s.%s equals secrets.participants.%s.%s — a custody key is per participant, never shared" $a.name $key $b.name $key) }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{- /* svc-edc — one realm client, one secret */}}
{{- $svcEdc := $sec | get "svcEdcSecret" "" }}
{{- range $enabled }}
{{- $v := index $psecAll .name | get "connectorClientSecret" "" }}
{{- if and $svcEdc $v (ne $v $svcEdc) }}
{{- fail (printf "secret policy: secrets.participants.%s.connectorClientSecret differs from secrets.svcEdcSecret — every EDC logs in as the one realm client svc-edc, so the values must be equal" .name) }}
{{- end }}
{{- if $v }}{{ $svcEdc = $v }}{{ end }}
{{- end }}

{{- /* org client — posture A's second copy of the connector's secret */}}
{{- if .Values.global.keycloak.sync.enabled }}
{{- range $alias, $client := ($sec | get "organisationClients" dict) }}
{{- range $enabled }}
{{- $clientId := dig "connector" "clientId" "" . }}
{{- if or (eq $clientId (printf "svc-ds-connector-%s" $alias)) (and (not $clientId) (eq .name $alias)) }}
{{- $mine := index $psecAll .name | get "organisationClientSecret" "" }}
{{- if ne ($client | get "connectorSecret" "") $mine }}
{{- fail (printf "secret policy: secrets.organisationClients.%s.connectorSecret differs from secrets.participants.%s.organisationClientSecret — org-sync would create the client with one and the connector log in with the other" $alias .name) }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{- /* R4 and the EDR halves. The x coordinates of services/connector/config/*-vault.properties'
       keys, which are public; a render test checks this list against the fixtures. */}}
{{- $devEdrKeyX := list "K-yAEzC24eWqvsZ8fgNIhOszsM0pRNcKwr8AkEp8x5M" "VRSMmFb0n5vlOQsElSmUsdbRfS-7d3_lV2UfFKcsYfA" "aG5tWWbDs57eXTu9DSBFUepQnw7XV8xuwjOQW5z3WK8" }}
{{- range $enabled }}
{{- $pp := . }}
{{- $vault := index $psecAll .name | get "edcVault" dict }}
{{- $private := fromYaml (toString ($vault | get "edrSigningPrivateJwk" "{}")) | default dict }}
{{- if has ($private | get "x" "") $devEdrKeyX }}
{{- fail (printf "secret policy: secrets.participants.%s.edcVault.edrSigningPrivateJwk is a committed dev fixture key — its private half is public, so every EDR it signs is forgeable. Generate one with task secrets:keygen" .name) }}
{{- end }}
{{- $publicRaw := toString ($vault | get "edrSigningPublicJwk" "") | trim }}
{{- if and (not $publicRaw) (has (.role | default "provider") (list "provider" "both")) }}
{{- fail (printf "secret policy: secrets.participants.%s.edcVault.edrSigningPublicJwk is required for a provider — the connector serves it at /internal/edr-jwks, where a data plane fetches the key to verify EDRs" .name) }}
{{- end }}
{{- if $publicRaw }}
{{- $public := fromYaml $publicRaw | default dict }}
{{- if hasKey $public "d" }}
{{- fail (printf "secret policy: secrets.participants.%s.edcVault.edrSigningPublicJwk carries a private member (d) — the connector must hold no private material; give it the public half only" .name) }}
{{- end }}
{{- range $c := list "kty" "crv" "x" "y" }}
{{- if ne (toString ($public | get $c "")) (toString ($private | get $c "")) }}
{{- fail (printf "secret policy: secrets.participants.%s.edcVault.edrSigningPublicJwk is not the public half of edrSigningPrivateJwk (%s differs) — the connector would serve a key no EDR was signed with" $pp.name $c) }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{- /* anchor — one host, however it is spelled */}}
{{- $derivedAnchor := printf "%s.%s" (.Values.global.hosts.trustAnchor | default "trust-anchor") .Values.global.baseDomain }}
{{- with .Values.authority.identityRegistry.trustAnchorDomain }}
{{- if ne . $derivedAnchor }}
{{- fail (printf "authority.identityRegistry.trustAnchorDomain is %q, but every participant derives the anchor as %q from global.hosts.trustAnchor and global.baseDomain — the anchor would sign as a DID no participant trusts. Leave it empty, or change baseDomain/hosts instead" . $derivedAnchor) }}
{{- end }}
{{- end }}

helmDefaults:
  wait: true
  timeout: 600
  atomic: true
  createNamespace: false # namespaces are owned by the ds-namespaces release

releases:
  # ── Namespaces (must exist and be labeled before anything lands in them) ─────
  - name: ds-namespaces
    namespace: default
    chart: ./charts/ds-namespaces
    createNamespace: false
    values:
      - authorityNamespace: {{ .Values.global.namespaces.authority | quote }}
        participantNamespaces:
        {{- range $participants }}
          - {{ printf "%s%s" $.Values.global.namespaces.participantPrefix .name | quote }}
        {{- end }}

  # ── Dataspace authority ─────────────────────────────────────────────────────
  - name: ds-identity-registry
    namespace: {{ .Values.global.namespaces.authority }}
    chart: ./charts/ds-identity-registry
    condition: authority.enabled
    needs:
      - default/ds-namespaces
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - trustAnchorDomain: {{ .Values.authority.identityRegistry.trustAnchorDomain | quote }}
        replicaCount: {{ .Values.authority.identityRegistry.replicaCount }}
        # **Every enabled participant's connector.** Promoting changes who is in
        # the registry, and a connector caches that list for its TTL — so it is
        # told rather than left to a timer. Rendered from the participant list
        # because a hand-maintained copy is a list that silently omits the
        # participant added last (`PT-11`, and the same class as `IR-10`: a
        # feature with no supply path is a feature that is off in production).
        connectorUrls: {{ $urls := list }}{{ range $participants }}{{ $urls = append $urls (printf "http://ds-connector-%s.%s%s.svc.cluster.local:30001" .name $.Values.global.namespaces.participantPrefix .name) }}{{ end }}{{ join "," $urls | quote }}
        credentialService:
          expose: {{ .Values.authority.identityRegistry.credentialService.expose }}
        # In-cluster callers outside the participant namespaces (the host
        # platform's onboarding), as the connector's `networkPolicy.ingressFrom`.
        networkPolicy:
          ingressFrom:
            {{- toYaml (dig "networkPolicy" "ingressFrom" list .Values.authority.identityRegistry) | nindent 12 }}
        # ADR-0029, the dataspace's own: the same block reaches every registry.
        didWeb:
          {{- toYaml (.Values.authority.identityRegistry | get "didWeb" dict) | nindent 10 }}
        # Passed through whole rather than key by key: a forgotten key here is
        # a flag that silently stops reaching the bootstrap, which is the
        # `PT-11` shape — a supply path that omits what was added last
        # (`seedItems` was the next one).
        bootstrap:
          {{- toYaml .Values.authority.identityRegistry.bootstrap | nindent 10 }}
        # ds1: the pairs `holder ← collector` of every participant with the
        # collector switch on (ADR-0026), added once both are active.
        collectors:
          {{- toYaml $collectorPairs | nindent 10 }}
        # ds4: the co-hosted participants whose code the anchor's hook registers.
        enrolment:
          participants:
            {{- toYaml $enrolments | nindent 12 }}
        keycloak:
          sync:
            enabled: {{ .Values.global.keycloak.sync.enabled }}
            organizationsConfigMap: {{ .Values.global.keycloak.sync.organizationsConfigMap | quote }}
            organisations:
              {{- toYaml (.Values.global.keycloak.sync.organisations | default dict) | nindent 14 }}
        secrets:
          organisationClients:
            {{- toYaml (.Values.secrets.organisationClients | default dict) | nindent 12 }}
          identityRegistryEncryptionKey: {{ .Values.secrets.identityRegistryEncryptionKey | quote }}
          serviceClientSecret: {{ .Values.secrets.svcDsIdentityRegistrySecret | quote }}
          dbPassword: {{ index .Values.secrets.postgres $anchorDb | quote }}
          # ds4: the code of each co-hosted participant with enrolment on, which
          # the anchor's hook registers (empty otherwise).
          enrolmentCodes:
            {{- range $enrolments }}
            {{ .alias }}: {{ index $psecAll .alias "enrolmentCode" | quote }}
            {{- end }}
          keycloakAdminUsername: {{ .Values.secrets.keycloakAdminUsername | quote }}
          keycloakAdminPassword: {{ .Values.secrets.keycloakAdminPassword | quote }}

  # ── Participants ────────────────────────────────────────────────────────────
{{- $root := . }}
{{- range $participants }}
{{- $p := . }}
{{- $ns := printf "%s%s" $root.Values.global.namespaces.participantPrefix $p.name }}
{{- $psec := index $root.Values.secrets.participants $p.name }}
{{- /*
The participant's `connector`, `edc`, `provenance` and `portal` blocks ARE those
charts' values, forwarded whole (chart parity row 17): a key a chart gains is
settable from the deployment's values the day it lands, instead of waiting for
someone to add a line here. What the helmfile owns — the participant's identity,
`global`, and every secret, which comes from the secrets file — cannot be set
through them, so a block naming one fails rather than silently competing.
*/}}
{{- $blocks := dict }}
{{- range $block := list "connector" "edc" "provenance" "portal" }}
{{- $cfg := deepCopy (get $block (dict) $p | default dict) }}
{{- range $owned := list "secrets" "participant" "global" "existingSecret" }}
{{- if hasKey $cfg $owned }}
{{- fail (printf "participants[%s].%s.%s cannot be set here: the helmfile owns it (identity from the participant entry, secrets from the secrets file)" $p.name $block $owned) }}
{{- end }}
{{- end }}
{{- $_ := set $blocks $block (omit $cfg "enabled") }}
{{- end }}
{{- /* The pre-forwarding spellings, refused by name so a deployment's old values file fails loudly. */}}
{{- range $old, $new := dict "notifyBackends" "notify.backends" "webhookAllowedHosts" "notify.webhookAllowedHosts" "governanceOverlayName" "governance.overlayName" "governanceConfigMap" "governance.configMap" }}
{{- if hasKey $blocks.connector $old }}
{{- fail (printf "participants[%s].connector.%s was renamed: the block is now the ds-connector chart's values, so write connector.%s" $p.name $old $new) }}
{{- end }}
{{- end }}

  # ── The participant's own identity registry ────────────────────────────────
  #
  # **The same chart as the authority's, with different values** — never a copy.
  # Adding a participant to a dataspace is adding a release here; if it ever
  # requires editing a template, the parameterisation is wrong.
  #
  # Its own database (`identity_registry_<name>`) and its own encryption key.
  # Sharing either would put every private key back in one place and make the
  # split three processes with one custody boundary, which is exactly what
  # `D-47` rules out.
  #
  # `ds-edc` needs it: this participant's DID document, credential service and
  # STS are served from here, on the participant's own host.
  - name: ds-identity-registry-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-identity-registry
    needs:
      - default/ds-namespaces
      - {{ $root.Values.global.namespaces.authority }}/ds-identity-registry
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - role: participant
        participant:
          name: {{ $p.name | quote }}
          did: {{ $p.did | default (printf "did:web:%s.%s" $p.name $root.Values.global.baseDomain) | quote }}
          dspAddress: {{ printf "https://%s.%s/protocol/2025-1" $p.name $root.Values.global.baseDomain | quote }}
        # The authority's release owns onboarding, agreements and the realm.
        bootstrap:
          enabled: true
        # ADR-0029: the dataspace's own hosts, the same allowance as the anchor's.
        didWeb:
          {{- toYaml ($root.Values.authority.identityRegistry | get "didWeb" dict) | nindent 10 }}
        keycloak:
          sync:
            enabled: false
        # No `serviceClientSecret` (chart parity row 28): its one reader is the
        # anchor's connector notification, and a participant never notifies. It
        # was fed the `svc-edc` secret under `svc-ds-identity-registry`'s name.
        secrets:
          identityRegistryEncryptionKey: {{ $psec.identityRegistryEncryptionKey | quote }}
          dbPassword: {{ index $root.Values.secrets.postgres (printf "%s%s_%s" $dbPrefix $dbBase.identityRegistry (replace "-" "_" $p.name)) | quote }}
          participantStsSecret: {{ $psec.stsSecret | quote }}
          {{- if dig "enrolment" "enabled" false $p }}
          enrolmentCode: {{ $psec.enrolmentCode | quote }}
          {{- end }}
        # ds4: spend the anchor-registered code once, if not enrolled.
        enrolment:
          enabled: {{ dig "enrolment" "enabled" false $p }}

  - name: ds-edc-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-edc
    needs:
      - default/ds-namespaces
      - {{ $root.Values.global.namespaces.authority }}/ds-identity-registry
      # Its Ingress points `/.well-known/did.json`, `/credentials` and `/sts` at
      # the release above — in this namespace, which is why the ExternalName
      # bridge to the authority namespace is gone.
      - {{ $ns }}/ds-identity-registry-{{ $p.name }}
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - participant:
          name: {{ $p.name | quote }}
          role: {{ $p.role | quote }}
          did: {{ $p.did | default "" | quote }}
      # ADR-0029 (extended): the dataspace's did:web allowance, read by ds's
      # DidWebGuardExtension; a participant's own `edc.didWeb` overrides it.
      - didWeb:
          {{- toYaml ($root.Values.authority.identityRegistry | get "didWeb" dict) | nindent 10 }}
      - {{ $blocks.edc | toYaml | nindent 8 }}
      - secrets:
          dbPassword: {{ index $root.Values.secrets.postgres (printf "%s%s_%s" $dbPrefix $dbBase.edc (replace "-" "_" $p.name)) | quote }}
          edcCallbackKey: {{ $psec.edcCallbackKey | quote }}
          edcControlApiKey: {{ $psec.edcControlApiKey | quote }}
          connectorClientSecret: {{ $psec.connectorClientSecret | quote }}
          stsClientSecret: {{ $psec.stsSecret | quote }}
          edrSigningPrivateJwk: {{ $psec.edcVault.edrSigningPrivateJwk | quote }}

  - name: ds-provenance-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-provenance
    needs:
      - default/ds-namespaces
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - participant:
          name: {{ $p.name | quote }}
          role: {{ $p.role | quote }}
      # ADR-0029 (extended): the dataspace's did:web allowance, the block every
      # identity registry gets; a participant's own `provenance.didWeb` overrides it.
      - didWeb:
          {{- toYaml ($root.Values.authority.identityRegistry | get "didWeb" dict) | nindent 10 }}
      - {{ $blocks.provenance | toYaml | nindent 8 }}
      - secrets:
          dbPassword: {{ index $root.Values.secrets.postgres (printf "%s%s_%s" $dbPrefix $dbBase.provenance (replace "-" "_" $p.name)) | quote }}
          subjectPseudonymKey: {{ $psec.provenanceSubjectPseudonymKey | quote }}
          # No `trustAnchorPublicJwk` here since `DID-17`: provenance verifies
          # `X-User-VC` against the key the anchor's DID document publishes.
          #
          # Worth remembering what this line used to be. It was **missing**, its
          # chart `required`d it, and because `helmfile template` could not run
          # without decryptable secrets nothing had ever rendered far enough to
          # notice — every production deploy would have failed at this release.
          # The value it distributed is a *public* key; the defect was that it
          # had to be distributed at all.

  - name: ds-connector-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-connector
    needs:
      - {{ $ns }}/ds-edc-{{ $p.name }}
      - {{ $ns }}/ds-provenance-{{ $p.name }}
      - {{ $root.Values.global.namespaces.authority }}/ds-identity-registry
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - participant:
          name: {{ $p.name | quote }}
          role: {{ $p.role | quote }}
          did: {{ $p.did | default "" | quote }}
      # governance, sync, networkPolicy.ingressFrom, trustAnchor, notify,
      # personTokenRequired, podAnnotations, clientId, vocabularies, … — the
      # chart's values, whole.
      # ADR-0029 (extended): the dataspace's did:web allowance, the block every
      # identity registry gets; a participant's own `connector.didWeb` overrides it.
      - didWeb:
          {{- toYaml ($root.Values.authority.identityRegistry | get "didWeb" dict) | nindent 10 }}
      {{- $myPortal := "" }}{{ if hasKey $portalHostOf $p.name }}{{ $myPortal = index $portalHostOf $p.name }}{{ end }}
      {{- with $myPortal }}
      # ds2: this participant's own portal, the link its notifications carry.
      - notify:
          portalBaseUrl: {{ printf "https://%s" . | quote }}
      {{- end }}
      - {{ $blocks.connector | toYaml | nindent 8 }}
      - secrets:
          dbPassword: {{ index $root.Values.secrets.postgres (printf "%s%s_%s" $dbPrefix $dbBase.connector (replace "-" "_" $p.name)) | quote }}
          # The organisation client, not `svc-ds-connector` — that one is an
          # audience only (plan `the-management-api-is-v3-behind-one-key`).
          clientSecret: {{ $psec.organisationClientSecret | quote }}
          edcCallbackKey: {{ $psec.edcCallbackKey | quote }}
          atRestKeys: {{ $psec.connectorAtRestKeys | quote }}
          keyIndexSecret: {{ $psec.connectorKeyIndexSecret | quote }}
          # Only with `connector.sync.clientId` (svc-ds-publisher).
          publisherSecret: {{ $psec | get "publisherSecret" "" | quote }}
          # The public half of this participant's EDR signing key, which the
          # connector serves at /internal/edr-jwks (chart parity OQ1 (b)). Kept
          # next to the private key in the secrets file; the policy above checks
          # the two agree. The connector holds no private material.
          edrPublicJwk: {{ $psec | get "edcVault.edrSigningPublicJwk" "" | quote }}

{{- if dig "federatedCatalog" "enabled" false $p }}
  {{- /*
      Which connector the crawl drives is NOT this participant's own.

      Catalogue discovery is a consumer-side operation: the crawl calls
      `POST /consumer/catalog`, and `services/connector/main.py` builds the
      consumer EDC client and mounts that router only when
      `CONNECTOR_ROLE=consumer`. The chart's `connectorServiceName` defaults to
      empty, which its own `_env.tpl` resolves to `ds-connector-<this
      participant>` — the PROVIDER-role one whenever a provider hosts the
      catalogue, which is the shipped arrangement. The symptom is a crawl that
      404s every cycle and a union catalogue that stays empty, with nothing in
      the chart to say why.

      Resolved from the roles already declared in values.yaml rather than left
      to an operator to notice. Compose has had this right since `P1-3`
      (`CATALOG_CONNECTOR_URL: http://172.17.0.1:31001`, the consumer stack);
      Helm disagreed with it, and Helm was wrong.
  */}}
  {{- $consumerName := "" }}
  {{- $consumerNs := "" }}
  {{- range $participants }}
    {{- /* `both` mounts the consumer router too (`settings.is_consumer`). */}}
    {{- if and (has (.role | default "") (list "consumer" "both")) (not $consumerName) }}
      {{- $consumerName = printf "ds-connector-%s" .name }}
      {{- $consumerNs = printf "%s%s" $root.Values.global.namespaces.participantPrefix .name }}
    {{- end }}
  {{- end }}
  {{- if not $consumerName }}
    {{- fail (printf "participant %q enables federatedCatalog, but no enabled participant declares `role: consumer` or `role: both`. The crawl calls POST /consumer/catalog, which only a consumer-role connector mounts — deploying this would produce a catalogue that is permanently empty. Give one participant `role: consumer` (or `both`), or set participants[].federatedCatalog.connectorServiceName explicitly." $p.name) }}
  {{- end }}
  - name: ds-federated-catalog-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-federated-catalog
    needs:
      - {{ $ns }}/ds-connector-{{ $p.name }}
      {{- if ne $consumerName (printf "ds-connector-%s" $p.name) }}
      # The connector it actually crawls through, which is normally another
      # participant's. Named here so the catalogue is not started against a
      # connector that does not exist yet. Not when it is this participant's
      # own (`role: both`): naming one release twice panics helmfile's DAG.
      - {{ $consumerNs }}/{{ $consumerName }}
      {{- end }}
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - participant:
          name: {{ $p.name | quote }}
          role: {{ $p.role | quote }}
        replicaCount: {{ dig "federatedCatalog" "replicaCount" 1 $p }}
        crawlInterval: {{ dig "federatedCatalog" "crawlInterval" 300 $p }}
        # The four the chart exposes and the helmfile used to pass none of, so
        # no deployment could override them at all.
        startupDelay: {{ dig "federatedCatalog" "startupDelay" 10 $p }}
        maxDatasetsPerProvider: {{ dig "federatedCatalog" "maxDatasetsPerProvider" 500 $p }}
        connectorServiceName: {{ dig "federatedCatalog" "connectorServiceName" (printf "%s.%s.svc.cluster.local" $consumerName $consumerNs) $p | quote }}
        connectorPort: {{ dig "federatedCatalog" "connectorPort" 30001 $p }}
        secrets:
          serviceClientSecret: {{ $root.Values.secrets.svcDsFederatedCatalogSecret | quote }}
{{- end }}

{{- if dig "portal" "enabled" false $p }}
  # The login surface. Deployed BEFORE the portal and named in its `needs`: the
  # portal's Ingress points `auth-url` at this Service, and an Ingress whose auth
  # backend does not resolve fails closed — every request 500s. Ordering makes
  # that a deploy-time wait instead of an outage.
  - name: ds-oauth2-proxy-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-oauth2-proxy
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - participant:
          name: {{ $p.name | quote }}
          role: {{ $p.role | quote }}
        # ds2: the portal's host, which is this proxy's too (one cookie domain).
        host: {{ index $portalHostOf $p.name | quote }}
        secrets:
          cookieSecret: {{ $root.Values.secrets.oauth2ProxyCookieSecret | quote }}
          clientSecret: {{ $root.Values.secrets.oauth2ProxyClientSecret | quote }}

  - name: ds-portal-{{ $p.name }}
    namespace: {{ $ns }}
    chart: ./charts/ds-portal
    needs:
      - {{ $ns }}/ds-connector-{{ $p.name }}
      - {{ $ns }}/ds-oauth2-proxy-{{ $p.name }}
    values:
      - global:
          {{- $global | toYaml | nindent 10 }}
      - participant:
          name: {{ $p.name | quote }}
          role: {{ $p.role | quote }}
        # The portal's federated-catalogue link exists only where that release
        # does (chart parity row 16).
        federatedCatalog:
          enabled: {{ dig "federatedCatalog" "enabled" false $p }}
        host: {{ index $portalHostOf $p.name | quote }}
      - {{ $blocks.portal | toYaml | nindent 8 }}
      - secrets:
          portalServiceClientSecret: {{ $root.Values.secrets.svcDsPortalSecret | quote }}
{{- end }}
{{- end }}
