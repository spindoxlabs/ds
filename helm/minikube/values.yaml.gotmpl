# Values of the `minikube` environment (helm/minikube/, docs/deployment/local-cluster.md):
# the charts under DS_ENV=production on a local cluster, with generic names only. Layered
# over helm/values.yaml; the secrets are helm/minikube/secrets.yaml, generated by
# `standalone.sh secrets` from this file and never committed.
#
# **The dev defaults live here, not in the scripts.** The participants, their roles and
# switches, the anchor's seed and governance, each participant's governance, the
# enrolment and the collector pair are values the charts render; the scripts only make
# the cluster (minikube.sh) and, without a host platform, its stand-ins (standalone.sh).
#
# A template for the binding's files (read here, so a changed file is a changed render
# and the pods roll) and the node's address, which DS_MK_NODE_IP carries (env.sh's `hf`
# sets it on every helmfile call). File contents sit in block scalars, so the file still
# parses as YAML before it is rendered (generate_secrets.py reads it that way).

global:
  baseDomain: ds.test
  namespaces:
    authority: ds-authority
    participantPrefix: ds-
  # Built from this checkout into the node (`minikube.sh build-images`, `images`).
  image:
    registry: ghcr.io/spindoxlabs
    prefix: ds-
    tag: minikube
    pullPolicy: Never
  ingress:
    className: nginx
    tls:
      clusterIssuer: ds-minikube-ca
      secretName: ""
  # The bundled CloudNativePG cluster (standalone.sh platform).
  postgres:
    host: ds-pg-rw.ds-platform.svc.cluster.local
    port: 5432
    sslMode: require
  # The bundled Keycloak with ds's dev realm; the token URL is the public host too:
  # the charts' egress admits 443 only, and Keycloak's issuer is that host anyway.
  keycloak:
    realm: dataspaces
    issuerUrl: https://keycloak.ds.test/realms/dataspaces
    adminUrl: https://keycloak.ds.test
    tokenUrl: https://keycloak.ds.test/realms/dataspaces/protocol/openid-connect/token
    sync:
      enabled: false
      organisations: {}
    aliases:
      groups: {}
      owners: {}
    mutate: false

authority:
  enabled: true
  identityRegistry:
    replicaCount: 1
    trustAnchorDomain: ""
    credentialService:
      expose: false
    # In-cluster, `*.ds.test` resolves to the node through ingress-dns: a private address,
    # admitted for these hosts only (ADR-0029). Forwarded to every registry, connector,
    # provenance and EDC: each fetches did:web behind the same guard.
    didWeb:
      internalHosts: [.ds.test]
      internalNetworks: ['{{ requiredEnv "DS_MK_NODE_IP" }}/32']
    bootstrap:
      enabled: true
      # The anchor's seed and governance, from the binding (charts: ds-identity-registry
      # renders the ConfigMaps and rolls the anchor when a file changes).
      seedFiles:
        agreements.yaml: |
          {{- readFile "binding/seed/agreements.yaml" | nindent 10 }}
        participation-en.md: |
          {{- readFile "binding/seed/content/participation-en.md" | nindent 10 }}
        owners.yaml: |
          {{- readFile "binding/seed/owners.yaml" | nindent 10 }}
      seedMountPath: /seed
      seedItems:
        - {key: agreements.yaml, path: agreements.yaml}
        - {key: participation-en.md, path: content/participation-en.md}
        - {key: owners.yaml, path: owners.yaml}
      governanceFiles:
        example-rec.governance.yaml: |
          {{- readFile "binding/governance/example-rec/governance.yaml" | nindent 10 }}
        example-dso.governance.yaml: |
          {{- readFile "binding/governance/example-dso/governance.yaml" | nindent 10 }}
      governanceMountPath: /governance
      orgApply:
        governance:
          - example-rec.governance.yaml
          - example-dso.governance.yaml
        verifiedBy: ds-minikube
        evidenceRef: helm/minikube/binding/seed/owners.yaml
        dryRun: false

# What both participants share: the host platform's consent writer and data plane call
# their connectors; here, the stand-ins (standalone.sh data-plane) in the platform
# namespace.
participantDefaults:
  connector:
    replicaCount: 1
    networkPolicy:
      ingressFrom:
        - namespace: ds-platform
          podLabels:
            app.kubernetes.io/name: onboarding
        - namespace: ds-platform
          podLabels:
            app.kubernetes.io/name: dataset-api
  provenance:
    replicaCount: 1
  edc:
    replicaCount: 1

participants:
  # A community that collects its members' consent and both provides and consumes.
  - name: example-rec
    enabled: true
    role: both
    did: ""
    connector:
      governance:
        files:
          governance.yaml: |
            {{- readFile "binding/governance/example-rec/governance.yaml" | nindent 12 }}
    federatedCatalog:
      enabled: false
    portal:
      enabled: true
      replicaCount: 1
      consumer:
        defaultAssigner: did:web:example-dso.ds.test
        defaultCounterPartyAddress: https://example-dso.ds.test/protocol/2025-1
    # Its members' consent is held at the grid operator's connector (ADR-0026; the
    # owners file marks it `collects_consent: true`).
    collector:
      enabled: true
      holders: [example-dso]
    # Both are hosted with the anchor: enrolled through the charts.
    enrolment:
      enabled: true

  # A grid operator that provides, and holds the consent the community registers.
  - name: example-dso
    enabled: true
    role: provider
    did: ""
    connector:
      governance:
        files:
          governance.yaml: |
            {{- readFile "binding/governance/example-dso/governance.yaml" | nindent 12 }}
    federatedCatalog:
      enabled: false
    portal:
      enabled: false
    enrolment:
      enabled: true
