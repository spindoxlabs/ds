# Values of the `minikube` environment (helm/minikube/minikube.sh, docs/deployment/
# local-cluster.md): the charts under DS_ENV=production on a local cluster, with generic
# names only. Layered over helm/values.yaml; the secrets are helm/minikube/secrets.yaml,
# generated by `minikube.sh secrets` and never committed.
#
# A template only for two runtime facts: the governance digests (a governance change is
# a checksum change, so the connector rolls) and the node's address, which DS_MK_NODE_IP
# carries (minikube.sh sets it on every helmfile call).

global:
  baseDomain: ds.test
  namespaces:
    authority: ds-authority
    participantPrefix: ds-
  # Built from this checkout into the node (`minikube.sh build-images`, `images`).
  image:
    registry: ghcr.io/spindoxlabs
    prefix: ds-
    tag: minikube
    pullPolicy: Never
  ingress:
    className: nginx
    tls:
      clusterIssuer: ds-minikube-ca
      secretName: ""
  # The bundled CloudNativePG cluster (minikube.sh platform).
  postgres:
    host: ds-pg-rw.ds-platform.svc.cluster.local
    port: 5432
    sslMode: require
  # The bundled Keycloak with ds's dev realm; the token URL is the public host too:
  # the charts' egress admits 443 only, and Keycloak's issuer is that host anyway.
  keycloak:
    realm: dataspaces
    issuerUrl: https://keycloak.ds.test/realms/dataspaces
    adminUrl: https://keycloak.ds.test
    tokenUrl: https://keycloak.ds.test/realms/dataspaces/protocol/openid-connect/token
    sync:
      enabled: false
      organisations: {}
    aliases:
      groups: {}
      owners: {}
    mutate: false

authority:
  enabled: true
  identityRegistry:
    replicaCount: 1
    trustAnchorDomain: ""
    credentialService:
      expose: false
    # In-cluster, `*.ds.test` resolves to the node through ingress-dns: a private address,
    # admitted for these hosts only (ADR-0029). Forwarded to every registry, connector,
    # provenance and EDC: each fetches did:web behind the same guard.
    didWeb:
      internalHosts: [.ds.test]
      internalNetworks: ['{{ requiredEnv "DS_MK_NODE_IP" }}/32']
    bootstrap:
      enabled: true
      seedConfigMap: ds-seed
      seedMountPath: /seed
      seedItems:
        - {key: agreements.yaml, path: agreements.yaml}
        - {key: participation-en.md, path: content/participation-en.md}
        - {key: owners.yaml, path: owners.yaml}
        - {key: bootstrap.sh, path: bootstrap.sh}
      governanceConfigMap: ds-governance
      governanceMountPath: /governance
      orgApply:
        governance:
          - example-rec.governance.yaml
          - example-dso.governance.yaml
        verifiedBy: ds-minikube
        evidenceRef: helm/minikube/binding/seed/owners.yaml
        dryRun: false

participants:
  - name: example-rec
    enabled: true
    role: both
    did: ""
    connector:
      replicaCount: 1
      governance:
        configMap: example-rec-governance
        checksum: '{{ readFile "binding/governance/example-rec/governance.yaml" | sha256sum }}'
      # The host platform's consent writer and data plane; here, the data-plane
      # stand-in (minikube.sh data-plane) in the platform namespace.
      networkPolicy:
        ingressFrom:
          - namespace: ds-platform
            podLabels:
              app.kubernetes.io/name: onboarding
          - namespace: ds-platform
            podLabels:
              app.kubernetes.io/name: dataset-api
    provenance:
      replicaCount: 1
    edc:
      replicaCount: 1
    federatedCatalog:
      enabled: false
    portal:
      enabled: true
      replicaCount: 1
      consumer:
        defaultAssigner: did:web:example-dso.ds.test
        defaultCounterPartyAddress: https://example-dso.ds.test/protocol/2025-1

  - name: example-dso
    enabled: true
    role: provider
    did: ""
    connector:
      replicaCount: 1
      governance:
        configMap: example-dso-governance
        checksum: '{{ readFile "binding/governance/example-dso/governance.yaml" | sha256sum }}'
      networkPolicy:
        ingressFrom:
          - namespace: ds-platform
            podLabels:
              app.kubernetes.io/name: onboarding
          - namespace: ds-platform
            podLabels:
              app.kubernetes.io/name: dataset-api
    provenance:
      replicaCount: 1
    edc:
      replicaCount: 1
    federatedCatalog:
      enabled: false
    portal:
      enabled: false
