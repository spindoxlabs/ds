# Decrypted secrets never belong in git; and here, in a public repository, the
# encrypted ones do not either (see the end of this file).
secrets.dec.yaml
secrets.yaml
/tmp-secrets.yaml

# Vendored chart dependencies (ds-common is a local file:// dep, re-resolved by
# `helm dependency update`).
charts/*/charts/
charts/*/Chart.lock

# A deployment's secrets live in its OWN repository (helm/README.md, "Install —
# from your own repository"): ds is public, and a real deployment's ciphertext
# must not be committed here, encrypted or not. Ignored so it cannot be.
secrets.sops.yaml

# The minikube setup: generated secrets and the local CA (helm/minikube/minikube.sh).
minikube/secrets.yaml
minikube/.certs/
