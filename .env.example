# ==============================================================================
# Dataspace runtime environment — REFERENCE / PRODUCTION CONTRACT
# ==============================================================================
#
# This file documents *every* environment variable the platform reads, what it
# does, and what happens if it leaks. It is the model the Helm chart is built
# from: each entry below maps to a chart value or a Kubernetes Secret key.
#
# It is deliberately NOT a working configuration. Values marked CHANGE_ME must
# be supplied; the platform refuses to start with them when DS_ENV=production.
#
#   Local development  → use .env.local (committed, zero-config, works as-is).
#                        Nothing in this file is needed to run the stack on a
#                        laptop or to run the e2e smoke tests.
#   Production         → copy this file, fill every CHANGE_ME, set DS_ENV=production.
#
# Secret generation:
#   openssl rand -hex 32                                          # API keys, cookie secrets
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'   # Fernet passphrase
#
# ------------------------------------------------------------------------------
# HOW ENFORCEMENT WORKS
# ------------------------------------------------------------------------------
# Every Python service runs a ProductionGuard (libs/ds-auth/src/ds_auth/production.py)
# at startup. It collects all insecure/missing values and then:
#
#   DS_ENV=dev                     → one warning per violation, starts normally.
#   DS_ENV unset, or any other     → logs ALL violations and REFUSES TO START.
#
# **The default is production, and that is deliberate.** It used to be `dev`,
# which meant forgetting the variable disarmed every guard — so the one case the
# guards exist for, nobody having thought about configuration, was the case they
# stayed silent in. Development now opts out explicitly in `.env.local`.
#
# The guard reports every violation at once, so a chart author gets the complete
# list in a single deploy rather than discovering them one at a time.
# ==============================================================================

# Deployment environment. Production is the DEFAULT — this line is here for
# explicitness, not because omitting it would weaken anything. Only `dev`
# downgrades the guards to warnings, and only `.env.local` and the compose files
# (the dev topology) set it.
DS_ENV=production

# Logging, read by `ds_obs.configure_logging` in every Python service. Process
# properties, so they are platform-wide rather than per-service — a deployment
# whose services log at different levels is one where a single request is
# reconstructed from several incompatible logs.
#
# Nothing configured logging before `libs/ds-obs`: the root logger dropped
# INFO, so every service's own `log.info` reached nobody and only failures were
# visible. If you see less than you expect, this is the switch.
DS_LOG_LEVEL=INFO
# `json` for a log shipper (one object per line), `text` for a person reading
# `docker logs`. The Helm chart defaults to json; compose leaves it text.
DS_LOG_FORMAT=json
# Successful /health and /metrics access lines are dropped by default — a probe
# every 10s and a scrape every 15s were burying every application event. A
# *failing* probe is always logged. Set true to restore them.
DS_LOG_ACCESS_HEALTH=false

COMPOSE_PROJECT_NAME=dataspaces


# ==============================================================================
# CRITICAL SECRETS — every one of these is a full compromise if leaked
# ==============================================================================

# EDC Management API key — create/delete assets, policies and contracts,
# terminate transfers.
# Leak → full contract administration of this participant's connector.
# It is no longer the credential the EDC extensions or the dataset-api present
# to ds-connector's /internal/* API; both now use their own Keycloak client
# credentials (SVC_EDC_* / SVC_DS_DATASET_API_*), so this value spans one trust
# boundary rather than three. ds-connector still accepts it on /internal/* as a
# fallback for un-migrated deployments; that branch is slated for removal.
# Dev default: insecure-dev-key
EDC_API_KEY=CHANGE_ME
# Alternative: read the key from a mounted file instead of the environment.
# Prefer this in Kubernetes (mount a Secret as a file).
# EDC_API_KEY_FILE=/run/secrets/edc-api-key

# The EDC **control** API key → WEB_HTTP_CONTROL_AUTH_KEY → web.http.control.auth.key.
#
# The control context hosts data-plane signalling, data-plane self-registration
# and the control-plane callback. Until `web.http.control.auth.type` was set,
# `GET /control/v1/dataplanes` answered 200 with the full data-plane registry to
# anything that could reach the port.
#
# Nothing outside the EDC holds this value — the control plane signals its own
# data plane in-process — so it is not distributed anywhere and can be a fresh
# random string per deployment. It is deliberately NOT EDC_API_KEY: that is the
# Management API's, and one secret across two boundaries is what this repository
# has already unpicked once.
# Dev default: insecure-dev-control-key
EDC_CONTROL_API_KEY=CHANGE_ME

# Which half of the identity-registry this instance is: `trust-anchor` or
# `participant`. One image, two roles.
#
#   trust-anchor  the governance authority's instance — issues credentials, owns
#                 the participant/owner/membership registries, serves the
#                 StatusList and takes organisation applications
#   participant   one organisation's own instance — serves only what a holder
#                 serves: its own DID documents, its own STS, its own credential
#                 service. Mounts no registry, issuance or onboarding route
#
# An unrecognised value is a refusal, not a fallback: a typo silently promoted to
# `trust-anchor` would hand a participant's deployment the ability to mint
# credentials. Each participant instance needs its own database and its own
# IDENTITY_REGISTRY_ENCRYPTION_KEY — sharing either puts the keys back in one
# place and makes the split cosmetic.
# Dev default: trust-anchor
IDENTITY_REGISTRY_ROLE=trust-anchor

# ── Participant role only ────────────────────────────────────────────────────
#
# The DID this instance holds the private key for. **Required when
# IDENTITY_REGISTRY_ROLE=participant** — the service refuses to start without it,
# because every route a participant mounts answers *for a DID it holds*, and with
# none configured it would report healthy and 404 everything.
# Dev default: unset (the anchor role does not use it)
# IDENTITY_REGISTRY_PARTICIPANT_DID=did:web:rec.dataspaces.localhost

# The DSP protocol endpoint this participant publishes as a `DSPEndpoint` service
# entry in its own DID document. The trust anchor reads it **from that document**
# at enrolment; it is never sent in a request, so a participant cannot claim an
# endpoint it does not publish.
# IDENTITY_REGISTRY_PARTICIPANT_DSP_ADDRESS=http://172.17.0.1:19194/protocol/2025-1

# Base URL of the trust anchor's Issuer Service, used once, at enrolment. Unset
# means `<scheme>://<IDENTITY_REGISTRY_TRUST_ANCHOR_DOMAIN>`, where the scheme
# follows IDENTITY_REGISTRY_DID_WEB_USE_HTTPS — so a production instance cannot
# enrol over plain HTTP by omission.
# IDENTITY_REGISTRY_TRUST_ANCHOR_URL=http://172.17.0.1:30005

# The secret this participant's **own** connector presents to this instance's
# STS. It is the participant's to choose: the trust anchor never mints one
# (`D-51`), because how a party authenticates to itself is not the anchor's
# decision. Guarded in the participant role only — on an anchor it is inert.
# Dev default: insecure-dev-secret
# IDENTITY_REGISTRY_PARTICIPANT_STS_SECRET=CHANGE_ME

# ── Dev topology: one registry instance per participant ──────────────────────
#
# The dev stack runs a trust anchor (:30005) plus one participant instance per
# organisation — `ir-rec` (:30006) and `ir-third-party` (:30007). Each holds
# its own DID key, encrypted with its **own** key: sharing one would put every
# private key back in one place and make the split cosmetic.
IR_REC_ENCRYPTION_KEY=dev-rec-encryption-key
IR_REC_STS_SECRET=insecure-dev-secret
IR_THIRD_PARTY_ENCRYPTION_KEY=dev-third-party-encryption-key
IR_THIRD_PARTY_STS_SECRET=insecure-dev-secret

# Fernet passphrase encrypting every DID private key this instance holds at rest.
# Leak → decrypt those private keys → impersonate their holder.
# LOSS → every stored private key becomes unrecoverable. Back this up.
# One per instance: the anchor and each participant encrypt with their own.
# Dev default: dev-encryption-key-change-in-production
IDENTITY_REGISTRY_ENCRYPTION_KEY=CHANGE_ME

# Resolve counterparty DID documents over TLS. A DCP presentation query is
# authorized by the requesting verifier's self-issued token, and its key comes
# from that verifier's DID document — over plain HTTP anyone on the path
# substitutes the key and speaks as that participant. Dev sets false because
# Caddy serves did:web on :80; production must not, and the ProductionGuard
# refuses to start if it does. Pairs with `edc.iam.did.web.use.https`.
# Dev default: false
IDENTITY_REGISTRY_DID_WEB_USE_HTTPS=true

# Written into provisioning bundles, so they must be reachable **from outside
# this deployment**: a third party configures its own instance from them, and an
# in-cluster DNS name here produces a connector that cannot resolve its own trust
# anchor. Defaults to https://<IDENTITY_REGISTRY_TRUST_ANCHOR_DOMAIN>.
# Dev default: http://172.17.0.1:30005
IDENTITY_REGISTRY_IDENTITY_REGISTRY_PUBLIC_URL=https://CHANGE_ME
# The realm issuer and name handed to a third party's connector in its bundle.
KEYCLOAK_ISSUER_URL=https://CHANGE_ME/realms/dataspaces
KEYCLOAK_REALM=dataspaces

# Keycloak admin account. Owns every identity in the dataspace.
#
# The identity-registry reads these for one purpose beyond realm sync: creating a
# third party's connector client when a provisioning bundle is issued. Unset, the
# bundle is still issued — without Keycloak credentials in it, so the third
# party's connector cannot authenticate to this registry.
# Dev default: admin / admin
KEYCLOAK_ADMIN_USERNAME=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# May the identity-registry WRITE to the realm? This is a posture, not a tuning
# knob, and there are exactly two answers:
#
#   true  — ds owns the realm. Promoting a participant creates
#           `svc-ds-connector-<alias>` and the bundle carries its secret.
#   false — ds is a guest in a realm somebody else administers. `helm/values.yaml`
#           states "KC is not ours to mutate"; there are no admin rights to have.
#           The bundle is still issued, without a Keycloak block, and whoever runs
#           the realm gives the participant its credentials.
#
# It used to be inferred from whether the admin credentials above happened to be
# set, so a deployment that supplied them for realm sync silently acquired
# client-creation too. With `true`, a dev-default admin password is a production
# guard violation — realm-admin rights behind the password `admin`.
# Dev default: true
KEYCLOAK_MUTATE=true

# PostgreSQL. In dev a single superuser backs all six databases; production
# should provision one least-privilege role per service instead.
# Dev default: postgres / postgres
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME


# ==============================================================================
# ZERO-TRUST ENFORCEMENT — these disable authentication when left at dev values
# ==============================================================================

# OIDC issuer per service. When unset, JWT signature/audience/issuer verification
# is DISABLED (see *_OIDC_INSECURE_DEV below). Setting the issuer enforces
# verification regardless of the insecure flag.
CONNECTOR_OIDC_ISSUER_URL=https://CHANGE_ME/realms/dataspaces
IDENTITY_REGISTRY_OIDC_ISSUER_URL=https://CHANGE_ME/realms/dataspaces
PROVENANCE_OIDC_ISSUER_URL=https://CHANGE_ME/realms/dataspaces
CATALOG_OIDC_ISSUER_URL=https://CHANGE_ME/realms/dataspaces

# Dev escape hatches. Each defaults to `true` in the service settings so the
# stack runs with no Keycloak. All four MUST be false in production.
CONNECTOR_OIDC_INSECURE_DEV=false
IDENTITY_REGISTRY_OIDC_INSECURE_DEV=false
PROVENANCE_OIDC_INSECURE_DEV=false
CATALOG_OIDC_INSECURE_DEV=false

# User Verifiable Credentials on the consent and consumer APIs are verified
# against the key the **trust anchor's DID document publishes** (`DID-17`), not
# against a key mounted here — so there is no key path to set, and rotating the
# anchor's key is not a redeploy of every service that held a copy.
#
# The trust list is the other half: resolution proves who signed a credential,
# the list proves the dataspace still accredits them (`DSSC-TRF-05`). Without it
# a withdrawn accreditation is invisible, so production requires both.
CONNECTOR_TRUST_ANCHOR_DID=did:web:CHANGE_ME
CONNECTOR_TRUST_LIST_URL=https://CHANGE_ME/trust
# false in production: DID documents carry the keys trust decisions rest on.
CONNECTOR_DID_WEB_USE_HTTPS=true
# Must be false in production; true skips signature verification entirely.
CONNECTOR_VC_INSECURE_DEV=false

# ds-provenance verifies the *same* credential on GET /prov/my/events, where a
# data subject reads their own history. Unverified, anyone could present any
# subject id and read that person's record — so these mirror the connector's.
PROVENANCE_TRUST_ANCHOR_DID=did:web:CHANGE_ME
PROVENANCE_TRUST_LIST_URL=https://CHANGE_ME/trust
PROVENANCE_DID_WEB_USE_HTTPS=true
PROVENANCE_VC_INSECURE_DEV=false

# Program arguments passed to the EDC runtime, after the jar. `--log-level=DEBUG`
# is the one that matters: EDC reports a failed identity verification with
# `monitor.debug`, so at the default level a rejected DSP request is an opaque
# 401 with **nothing** in either log — which is most of why `EDC-17` went
# unexplained for as long as it did.
# Dev default: unset
EDC_PROG_ARGS=

# The ODRL profile namespace `services/edc-extensions` binds its operands under.
# EDC maps ENVIRONMENT_NOTATION to dot.notation, so this arrives as
# `dataspaces.odrl.namespace`.
#
# **It must equal the `namespace` of the ODRL profile ds-connector maps with**
# (`libs/governance/src/ds/governance/profiles/energy.yaml`, or whatever
# `CONNECTOR_ODRL_PROFILE_PATH` points at). The two are configured
# independently, and a mismatch is silent in the worst way: the connector
# publishes `{new}Membership` and `{new}ConsentStatus`, the extension binds
# `{old}…`, EDC's ScopeFilter *removes* the unbound operands, and every
# negotiation succeeds with no policy enforced and nothing logged. The
# binding-vs-emission conformance test in `libs/governance` is what catches the
# drift; this comment is what stops it being introduced.
# Dev default: https://w3id.org/dsp/policy/ (the extension's own default)
DATASPACES_ODRL_NAMESPACE=https://w3id.org/dsp/policy/

# Lifetime of the EDC's two decision caches — the membership check and the
# consent pending guard. Both caches are bounded regardless, and a value that is
# not a positive number of seconds is logged and ignored rather than taking the
# connector down at boot.
#
# **Not only tuning.** It is the window in which the platform cannot fail closed:
# a decision taken while ds-connector was reachable is reused for this long after
# it stops being. Measured against a stopped connector: a negotiation refused at
# ~75s of downtime succeeded at ~10s, and service resumed ~70s after the
# connector came back rather than immediately. `ds-e2e --flow fail-closed` reads
# this same variable and outlasts it in both directions, so raising it lengthens
# that flow rather than weakening it.
#
# It reached **nothing** until the compose files were given it (`E2E-06`): the
# name was documented here and passed to no EDC container, so the extension's own
# 60s default was the only value the platform ever had.
# Dev default: 60
DS_ACCESS_SCOPE_CACHE_TTL_SECONDS=60


# ==============================================================================
# KEYCLOAK SERVICE CLIENTS
# ==============================================================================
# Defined in services/keycloak/clients.yaml. In dev each secret defaults to its
# own client_id (e.g. svc-ds-portal / svc-ds-portal) — guessable, and several of
# these clients hold admin-level scopes:
#
#   svc-ds-portal            connector.provider.*, identity-registry.read, ...
#   svc-ds-onboarding        identity-registry.admin
#   svc-ds-identity-registry identity-registry.admin
#
# No service client carries a `*.admin` scope on the connector: admin is an
# operator grant (a user's own token or an admin CLI), and it is a superset, so
# granting it to a process hands that process every permission of that service.

SVC_DS_IDENTITY_REGISTRY_SECRET=CHANGE_ME
SVC_DS_ONBOARDING_SECRET=CHANGE_ME
SVC_DS_PORTAL_SECRET=CHANGE_ME
SVC_DS_CONNECTOR_SECRET=CHANGE_ME
SVC_DS_FEDERATED_CATALOG_SECRET=CHANGE_ME
# Declared so the audience ds-provenance verifies is a revocable identity rather
# than a literal string in four audience-mapper lists. Nothing authenticates *as*
# provenance, so this client holds no grants — but with oauth2-proxy in front of
# humans it is also what makes a user's token carry `aud: svc-ds-provenance`.
SVC_DS_PROVENANCE_SECRET=CHANGE_ME
# The dataset-api PEP's identity on ds-connector /internal/* — consent checks
# and the row-filter subject list. Holds connector.internal.
SVC_DS_DATASET_API_SECRET=CHANGE_ME
# The EDC JVM's identity: /internal/* during ODRL policy evaluation, and
# /webhooks/contract-negotiation to report its own negotiation state. Holds
# connector.internal + connector.webhook + identity-registry.read. Replaces
# EDC_API_KEY on those calls, so a leak here does not also hand over EDC's
# Management API, and /internal/* callers become distinguishable in an audit.
SVC_EDC_SECRET=CHANGE_ME
# The end-to-end suite's identity. It authenticates as a service client like any
# other caller, so it is a real credential in a real realm — `ds-e2e` cannot
# exercise the authorization perimeter with a credential the perimeter ignores.
SVC_DS_E2E_SECRET=CHANGE_ME
# The domain rec-registry's identity, declared by the `clients.energy.yaml`
# overlay. It reaches this file because `keycloak-sync` mounts the **effective**
# declaration (core + overlays) — a placeholder unresolved there leaves the realm
# holding the client id, exactly like any core client.
SVC_REC_REGISTRY_SECRET=CHANGE_ME

# Identity-registry's realm/org provisioning target. Writes are performed with
# KEYCLOAK_ADMIN_USERNAME/PASSWORD below; there is no separate client credential.
KEYCLOAK_ADMIN_URL=https://CHANGE_ME


# Refuse a provider write when the caller carries no Keycloak organisation claims.
# Leave false where organisations are not modelled: refusing there breaks every
# single-owner deployment and pushes operators towards `connector.admin`, which
# crosses every owner and is worse than the thing being prevented. Set **true**
# wherever Keycloak organisations model dataset owners — then a missing claim means
# the caller was never scoped, not that scoping is off.
# Callers who do carry organisation claims are scoped either way.
# Dev default: false
CONNECTOR_OWNER_SCOPING_STRICT=false

# ── Layer B — a foreign IdP's names, translated ───────────────────────────────
# Both maps are **deployment** configuration, because they are about someone
# else's naming. Neither can grant anything ds does not already define.
#
# Group names → ds role bundles. An alias may only name a bundle
# (ds-admin, ds-onboarding-operator, ds-participant-admin, ds-participant-viewer,
# ds-member) — never a capability. Anything else is dropped and logged, so
# deployment config cannot become a permission table. Set on **every** service:
# a half-wired map is a deployment where authority depends on which service
# answered.
#   {"celine-manager":"ds-participant-admin"}
# Dev default: {"legacy-provider-admin":"ds-participant-admin"}
CONNECTOR_OIDC_GROUP_ALIASES=
IDENTITY_REGISTRY_OIDC_GROUP_ALIASES=
PROVENANCE_OIDC_GROUP_ALIASES=
CATALOG_OIDC_GROUP_ALIASES=
PORTAL_OIDC_GROUP_ALIASES=

# Organisation names → ds `Owner` ids. Without it, per-owner scoping cannot work
# in a realm ds did not name: the claim's aliases match no Owner.id, every
# comparison fails and every operator is refused.
#   {"CELINE-REC-01":"example-org"}
# Dev default: empty (the realm already uses ds owner ids)
CONNECTOR_OWNER_ALIASES=

# ==============================================================================
# HUMAN LOGIN (oauth2-proxy)
# ==============================================================================
# The portal is **not** an OIDC client. oauth2-proxy holds the browser session
# and Caddy delegates to it with forward_auth; the portal reads the forwarded
# access token and every ds service re-verifies it. So there is no portal login
# client id, no portal client secret and no session-encryption key here.
#
# The Keycloak client is declared in the realm import (`realm-*.json`), because
# `celine-policies keycloak sync` only attaches audience mappers to it — it does
# not create it. Its redirect URI must be `<OAUTH2_PROXY_BASE_URL>/oauth2/callback`,
# port included: a missing port is the most common cause of a redirect loop.
OAUTH2_PROXY_BASE_URL=https://CHANGE_ME
OAUTH2_PROXY_CLIENT_ID=oauth2_proxy
# Leak → sign in as any user of the realm.
# Dev default: oauth2_proxy
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
# Encrypts the proxy's session cookie. Leak → forge a browser session with any
# identity. Must be 16, 24 or 32 bytes.
# Dev default: a literal in services/oauth2-proxy/oauth2-proxy.cfg
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME

# Public origin of the portal.
ORIGIN=https://CHANGE_ME

# `<SERVICE>_SERVICE_CLIENT_SECRET` is **not set here, for any service.**
#
# Each of these names the same Keycloak client as an `SVC_*_SECRET` above, and a
# client has one secret. Set the `SVC_*` one; every deployment path derives the
# service-side name from it — compose in the service's `environment:` block
# (`PORTAL_SERVICE_CLIENT_SECRET: ${SVC_DS_PORTAL_SECRET:-svc-ds-portal}`), Helm
# in `helmfile.yaml.gotmpl`. `CONNECTOR_`, `CATALOG_` and `DATASET_API_` have
# always worked this way.
#
# The two that did not are why this note exists. `PORTAL_SERVICE_CLIENT_SECRET`
# was declared here *and* generated its own random value by `secrets:generate`,
# so a freshly bootstrapped production env gave the realm one secret and the
# portal a different one — the client could not authenticate, and only the
# host-run portal path showed it. `IDENTITY_REGISTRY_SERVICE_CLIENT_SECRET` was
# declared here and read by nothing, so it stayed `CHANGE_ME` and tripped
# `secrets:check` for no reason. Do not re-add either.
PORTAL_SERVICE_CLIENT_ID=svc-ds-portal


# ==============================================================================
# PORTAL UPSTREAMS (server-side only — the browser never calls these)
# ==============================================================================
# The portal is SSR: every URL below is dialled from the portal process, so use
# in-cluster/backend addresses, never a browser-facing one.
CONNECTOR_URL=http://CHANGE_ME:30001
PROVENANCE_URL=http://CHANGE_ME:30000
FEDERATED_CATALOG_URL=http://CHANGE_ME:30003
IDENTITY_REGISTRY_URL=http://CHANGE_ME:30005
# The dataset-api. Backs the catalogue detail view, /my-data's "data held about
# you" list and the health page's dataset-api probe. Unset, those degrade to an
# error state — the portal has no other address for them.
CATALOGUE_URL=http://CHANGE_ME:30002
# The connector the /consumer/* routes drive. In dev one portal fronts both
# stacks, so this differs from CONNECTOR_URL; per participant they are the same.
CONSUMER_CONNECTOR_URL=http://CHANGE_ME:31001
# The DID the portal reports as the consumer when querying data through an EDR.
# Wrong value → the provider's PEP rejects the query.
CONSUMER_PARTICIPANT_DID=did:web:CHANGE_ME


# ==============================================================================
# PARTICIPANT IDENTITY
# ==============================================================================
# The DIDs this deployment acts as. In dev these are *.dataspaces.localhost;
# production must use real did:web domains resolvable over HTTPS.
CONNECTOR_PARTICIPANT_DID=did:web:CHANGE_ME
CONNECTOR_CONSUMER_PARTICIPANT_DID=did:web:CHANGE_ME
IDENTITY_REGISTRY_TRUST_ANCHOR_DOMAIN=CHANGE_ME

# Role of this connector instance: `provider` or `consumer`. Required, no default.
CONNECTOR_ROLE=provider


# ==============================================================================
# DATABASES
# ==============================================================================
# One database per service. Production should use a distinct least-privilege
# role per URL rather than the shared superuser used in dev.
IDENTITY_REGISTRY_DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/identity_registry
CONNECTOR_DATABASE_URL_PROVIDER=postgresql+asyncpg://USER:PASS@HOST:5432/connector_rec
CONNECTOR_DATABASE_URL_CONSUMER=postgresql+asyncpg://USER:PASS@HOST:5432/connector_third_party
PROVENANCE_DATABASE_URL_PROVIDER=postgresql+asyncpg://USER:PASS@HOST:5432/provenance_rec
PROVENANCE_DATABASE_URL_CONSUMER=postgresql+asyncpg://USER:PASS@HOST:5432/provenance_third_party
EDC_PROVIDER_DB_URL=jdbc:postgresql://HOST:5432/edc_rec
EDC_CONSUMER_DB_URL=jdbc:postgresql://HOST:5432/edc_third_party


# ==============================================================================
# EDC ENDPOINTS
# ==============================================================================
# Management APIs are privileged — never expose them publicly. In Kubernetes
# these should be ClusterIP-only.
EDC_PROVIDER_MANAGEMENT_URL=http://edc-rec:19193/management
EDC_CONSUMER_MANAGEMENT_URL=http://edc-third-party:29193/management
# There is no EDC_*_PROTOCOL_URL. The DSP address other participants dial is the
# EDC's own `edc.dsp.callback.address` (services/connector/config/*.properties in
# compose, the ds-edc ConfigMap under Helm), and a *counter-party's* address is
# looked up in the identity registry by the connector. Nothing in ds read the two
# variables that used to be here.
# The EDC reports its negotiation lifecycle to ds-connector from inside the
# extensions (NegotiationEventPublisher), addressed by ds.connector.internal.url
# in services/connector/config/*.properties. There is no callback-URL variable:
# EDC 0.16.0 has no `edc.receiver.http.*` setting, and the static-callback
# extension would need a fourth shared secret to authenticate.


# ==============================================================================
# INTERNAL SERVICE URLS
# ==============================================================================
CONNECTOR_IDENTITY_REGISTRY_URL=http://identity-registry:30005
# Despite the name, this is read by `ds-e2e` and by nothing in the connector:
# the traffic goes the other way — the dataset API calls
# POST /internal/dataplane/authorize — and the address a consumer is handed is
# the asset's data_address.base_url in governance.yaml. Setting it does not move
# the data plane; it tells the e2e suite where to look for one.
CONNECTOR_DATASET_API_URL=http://dataset-api:30002
CONNECTOR_PROVENANCE_URL_PROVIDER=http://ds-provenance-rec:30000
CONNECTOR_PROVENANCE_URL_CONSUMER=http://ds-provenance-third-party:31000
CONNECTOR_URL=http://ds-connector-rec:30001
FEDERATED_CATALOG_URL=http://ds-federated-catalog:30003
CATALOG_CONNECTOR_URL=http://ds-connector-third-party:31001
CATALOG_IDENTITY_REGISTRY_URL=http://identity-registry:30005
DATASET_API_CONNECTOR_INTERNAL_URL=http://ds-connector-rec:30001

# Keycloak token endpoints for client-credentials service tokens.
CONNECTOR_KEYCLOAK_TOKEN_URL=https://CHANGE_ME/realms/dataspaces/protocol/openid-connect/token
CATALOG_KEYCLOAK_TOKEN_URL=https://CHANGE_ME/realms/dataspaces/protocol/openid-connect/token
DATASET_API_KEYCLOAK_TOKEN_URL=https://CHANGE_ME/realms/dataspaces/protocol/openid-connect/token
# Consumed by the EDC JVM (ds.connector.internal.token.url in *.properties).
DS_KEYCLOAK_TOKEN_URL=https://CHANGE_ME/realms/dataspaces/protocol/openid-connect/token
KEYCLOAK_TOKEN_URL=https://CHANGE_ME/realms/dataspaces/protocol/openid-connect/token

# Which client each of those two authenticates as. The secrets are the
# SVC_*_SECRET values above; these are only the client ids.
DATASET_API_SERVICE_CLIENT_ID=svc-ds-dataset-api
DS_CONNECTOR_CLIENT_ID=svc-edc


# ==============================================================================
# DSP DEFAULTS (consumer-side catalogue browsing)
# ==============================================================================
CONSUMER_DEFAULT_COUNTER_PARTY_ADDRESS=https://CHANGE_ME/protocol/2025-1
CONSUMER_DEFAULT_ASSIGNER=did:web:CHANGE_ME


# ==============================================================================
# OPTIONAL / TUNING — safe defaults, override only when needed
# ==============================================================================

# Governance overlay merged on top of governance.yaml (e.g. `prod`).
# CONNECTOR_GOVERNANCE_OVERLAY_NAME=
# CONNECTOR_ODRL_PROFILE_PATH=

# Semantic vocabularies served from GET /ns/{slug}, matched to a dataset by its
# `dcat.conforms_to` URI. Defaults to vocabularies.yaml beside governance.yaml.
#
# **Blast radius: the connector refuses to start** if a registered vocabulary has
# no local copy and cannot be fetched. That is deliberate — booting while
# /ns/{slug} 404s publishes a reference the catalogue names and this participant
# cannot serve. The shipped registry is empty, so this costs a default install
# nothing; registering entries opts into a startup dependency on their sources.
# Fill the cache ahead of a restart with `task vocab:fetch`.
# CONNECTOR_VOCABULARIES_PATH=
# CONNECTOR_VOCABULARIES_OVERLAY_NAME=
# CONNECTOR_VOCABULARY_CACHE_DIR=data/vocabularies
# Credential revocation (StatusList2021).
# CONNECTOR_CREDENTIAL_STATUS_URL=
# CONNECTOR_CREDENTIAL_STATUS_PATH=
# Accept participants absent from the registry. Keep false.
# CONNECTOR_ALLOW_UNKNOWN_PARTICIPANTS=false
# Negotiation/transfer polling.
# CONNECTOR_NEGOTIATION_TIMEOUT=120
# CONNECTOR_TRANSFER_TIMEOUT=120
# CONNECTOR_NEGOTIATION_POLL_INTERVAL=2
# CONNECTOR_TRANSFER_POLL_INTERVAL=2
# Consent notification backends: null, smtp, webhook (comma-separated).
# CONNECTOR_NOTIFY_BACKENDS=null
# Registry cache TTL (seconds).
# CONNECTOR_OWNERS_REGISTRY_CACHE_TTL=300

# Credential lifetimes (days).
# IDENTITY_REGISTRY_DEFAULT_CREDENTIAL_TTL_DAYS=365
# IDENTITY_REGISTRY_MAX_CREDENTIAL_TTL_DAYS=730

# Federated catalog crawler.
# CATALOG_CRAWL_INTERVAL=300
# CATALOG_STARTUP_DELAY=10
# CATALOG_MAX_DATASETS_PER_PROVIDER=500

# Provenance lineage traversal cap.
# PROVENANCE_MAX_LINEAGE_DEPTH=20

# The `@context` IRI on every JSON-LD response this service returns. The default
# is a dev host, so any deployment that serves the graph to a reader outside the
# dev stack must set it — an unresolvable `@context` makes the payload untypeable.
# PROVENANCE_CONTEXT_URL=https://provenance.dataspaces.localhost/prov/context

# Dataset API mock. Point at a real dataset API to replace the built-in fixtures.
# DATASET_API_EXTERNAL_QUERY_URL=
#
# There is deliberately no `DATASET_API_ENFORCE_CONSENT`. One used to be listed
# here, set in compose and defaulted to `true` in the service — and read by
# nothing. Consent enforcement in a PEP is not a switch: the decision is ds's,
# and this service either applies it or refuses.

# Sibling checkouts built from source by docker-compose.dataset-api.yml — the
# real-dataset-api stack only (`./services/dataset-api-mock/fixtures/seed.sh`).
# `task start` and the mock need none of these.
#
# Defaults assume the layout in AGENTS.md, "Assumed workspace layout":
#   <workspace>/celine-eu/celine-dev/repositories/   the three below
#   <workspace>/spindoxlabs/ds/                      this repo
# Set these in .env for any other layout — never edit the compose file.
# DATASET_API_PATH=../../celine-eu/celine-dev/repositories/dataset-api
# REC_REGISTRY_PATH=../../celine-eu/celine-dev/repositories/rec-registry
# CELINE_SDK_PATH=../../celine-eu/celine-dev/repositories/celine-sdk

# Debug/reload. Never enable in production.
# CONNECTOR_DEBUG=false
# IDENTITY_REGISTRY_DEBUG=false
# PROVENANCE_DEBUG=false
