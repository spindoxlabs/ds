# Local development defaults — committed, zero-config.
#
# These values make `task start` and the e2e smoke tests work with no setup.
# They are deliberately weak and deliberately public: this file is the dev
# baseline, not a template. See .env.example for the documented reference of
# every variable and for what a production deployment must supply.
#
# Override per-machine in .env (gitignored).

COMPOSE_PROJECT_NAME=dataspaces

# **The unsafe mode, asked for explicitly.** `ProductionGuard` defaults to
# `production` — forgetting this variable used to disarm every guard in the
# platform, which meant the one case the guards exist for (nobody thought about
# configuration) was the one case they stayed quiet in. So the safe state is now
# the default, and development opts out here, in the file whose whole purpose is
# to be the dev baseline.
#
# With this set, each service logs a warning per insecure default and starts.
# Remove it and the stack refuses to start on the dev secrets below — which is
# what a deployment that never set it should get.
DS_ENV=dev

# ── Shared secrets (dev-only values) ──────────────────────────────────────────
EDC_API_KEY=insecure-dev-key

# ── EDC ───────────────────────────────────────────────────────────────────────
EDC_PROVIDER_MANAGEMENT_URL=http://172.17.0.1:19193/management
EDC_CONSUMER_MANAGEMENT_URL=http://172.17.0.1:29193/management
EDC_PROVIDER_DB_URL=jdbc:postgresql://172.17.0.1:35432/edc_rec
EDC_CONSUMER_DB_URL=jdbc:postgresql://172.17.0.1:35432/edc_third_party

# ── Identity ──────────────────────────────────────────────────────────────────
CONNECTOR_PARTICIPANT_DID=did:web:rec.dataspaces.localhost
CONNECTOR_CONSUMER_PARTICIPANT_DID=did:web:third-party.dataspaces.localhost

# ── Service URLs ──────────────────────────────────────────────────────────────
CONNECTOR_IDENTITY_REGISTRY_URL=http://172.17.0.1:30005
# Read by `ds-e2e`, not by the connector — the name predates the split. The
# connector never calls the dataset API; the dataset API calls it.
CONNECTOR_DATASET_API_URL=http://172.17.0.1:30002
# Consumer-side only: "is this negotiation of mine parked on a consent
# decision?" Empty disables it and a long REQUESTED simply stays REQUESTED.
CONNECTOR_PROVIDER_CONNECTOR_URL=http://172.17.0.1:30001
CONNECTOR_PROVENANCE_URL_PROVIDER=http://172.17.0.1:30000
CONNECTOR_PROVENANCE_URL_CONSUMER=http://172.17.0.1:31000
CONNECTOR_DATABASE_URL_PROVIDER=postgresql+asyncpg://postgres:postgres@172.17.0.1:35432/connector_rec
CONNECTOR_DATABASE_URL_CONSUMER=postgresql+asyncpg://postgres:postgres@172.17.0.1:35432/connector_third_party

# ── Identity Registry ─────────────────────────────────────────────────────────
IDENTITY_REGISTRY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@172.17.0.1:35432/identity_registry

# ── Provenance ────────────────────────────────────────────────────────────────
PROVENANCE_DATABASE_URL_PROVIDER=postgresql+asyncpg://postgres:postgres@172.17.0.1:35432/provenance_rec
PROVENANCE_DATABASE_URL_CONSUMER=postgresql+asyncpg://postgres:postgres@172.17.0.1:35432/provenance_third_party

# ── Federated Catalog ─────────────────────────────────────────────────────────
CATALOG_CONNECTOR_URL=http://172.17.0.1:31001
CATALOG_IDENTITY_REGISTRY_URL=http://172.17.0.1:30005

# ── Dataset API ───────────────────────────────────────────────────────────────
DATASET_API_CONNECTOR_INTERNAL_URL=http://172.17.0.1:30001

# ── Keycloak / OIDC ──────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URL=http://keycloak.dataspaces.localhost/realms/dataspaces
# oauth2-proxy is the human login surface. It is internal (no host port) and
# reached only through Caddy; the client is declared in the realm import and its
# dev secret equals the client id, as the service clients' do.
OAUTH2_PROXY_BASE_URL=http://sso.dataspaces.localhost
OAUTH2_PROXY_CLIENT_ID=oauth2_proxy
OAUTH2_PROXY_CLIENT_SECRET=oauth2_proxy

# ── Portal ────────────────────────────────────────────────────────────────────
PORTAL_SERVICE_CLIENT_ID=svc-ds-portal
PORTAL_SERVICE_CLIENT_SECRET=svc-ds-portal
ORIGIN=http://portal.dataspaces.localhost
CONNECTOR_URL=http://172.17.0.1:30001
FEDERATED_CATALOG_URL=http://172.17.0.1:30003
CATALOGUE_URL=http://172.17.0.1:30002
CONSUMER_CONNECTOR_URL=http://172.17.0.1:31001
# Set explicitly rather than relying on the in-code fallbacks: the portal is the
# only place that would otherwise invent a participant DID, and a wrong assigner
# fails a negotiation with no useful error.
#
# COUNTER_PARTY_ADDRESS must be the address registered as the participant's
# `dsp_address` in the identity registry — the connector resolves it there and
# answers 400 "Unknown dataspace participant" for anything else. It is an
# identity, not a route: the container-DNS form (edc-rec:19194) is equally
# reachable and still rejected.
CONSUMER_PARTICIPANT_DID=did:web:third-party.dataspaces.localhost
CONSUMER_DEFAULT_ASSIGNER=did:web:rec.dataspaces.localhost
CONSUMER_DEFAULT_COUNTER_PARTY_ADDRESS=http://172.17.0.1:19194/protocol/2025-1

# ── Service tokens ────────────────────────────────────────────────────────────
SVC_DS_PORTAL_ID=svc-ds-portal
SVC_DS_PORTAL_SECRET=svc-ds-portal
# The e2e harness has its own client so the portal does not have to carry the
# permissions a test driver needs. Dev/CI realms only.
SVC_DS_E2E_ID=svc-ds-e2e
SVC_DS_E2E_SECRET=svc-ds-e2e
KEYCLOAK_TOKEN_URL=http://172.17.0.1:9080/realms/dataspaces/protocol/openid-connect/token

# The EDC JVM's own identity when it calls ds-connector (/internal/* during
# policy evaluation, /webhooks/* to report negotiation state). It used to
# present EDC_API_KEY, which is *also* EDC's Management API key — one leaked
# value would have yielded contract administration, the data-plane signing keys
# and the subject pools together, with no audit trail distinguishing the EDC
# from the dataset-api.
SVC_EDC_ID=svc-edc
SVC_EDC_SECRET=svc-edc
# EDC reads the environment as config, mapping ENVIRONMENT_NOTATION to
# dot.notation — so these ARE `ds.connector.internal.*` and
# `web.http.management.auth.key`. They cannot live in the .properties files:
# EDC does a plain Properties.load() and would store a ${...} verbatim.
# Consumed by the local `task edc-rec:run` / `edc-third-party:run` JVMs;
# docker-compose sets the same names on the edc-* services.
WEB_HTTP_MANAGEMENT_AUTH_KEY=insecure-dev-key
DS_CONNECTOR_INTERNAL_TOKEN_URL=http://172.17.0.1:9080/realms/dataspaces/protocol/openid-connect/token
DS_CONNECTOR_INTERNAL_CLIENT_ID=svc-edc
DS_CONNECTOR_INTERNAL_CLIENT_SECRET=svc-edc

# The dataset-api PEP's identity on /internal/*. Its Keycloak client already
# holds connector.internal; this just stops it reaching for the shared secret.
SVC_DS_DATASET_API_ID=svc-ds-dataset-api
SVC_DS_DATASET_API_SECRET=svc-ds-dataset-api

# The audience ds-provenance verifies, now a declared client. No grants: callers
# authenticate *to* provenance, never *as* it.
SVC_DS_PROVENANCE_SECRET=svc-ds-provenance

# The real dataset-api (docker-compose.dataset-api.yml) is under test on 30002,
# so the mock moves aside. Unset this to put the mock back on 30002 and stop the
# real one.
DATASET_API_MOCK_PORT=30022

# ── Layer B: a foreign IdP's group names → ds role bundles ───────────────────
# Dev carries one deliberately foreign-looking group, `legacy-provider-admin`,
# which is **not** a ds bundle and therefore grants nothing on its own. The map
# below is what turns it into `ds-participant-admin` — so the translation path is
# exercised by `ds-e2e --flow user-authority` against a real token, rather than
# only by unit tests that would agree with whatever they were given.
# Set on both services the flow asserts against, so a refusal there is a refusal
# for the right reason.
CONNECTOR_OIDC_GROUP_ALIASES={"legacy-provider-admin":"ds-participant-admin"}
IDENTITY_REGISTRY_OIDC_GROUP_ALIASES={"legacy-provider-admin":"ds-participant-admin"}
